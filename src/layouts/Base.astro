---
// 布局壳 — spec §1(FOUC 守卫)/§3(app bar + footer)/§4.2(腐烂可见 meta)/T3(LCP preload)
import AppBar from '../components/AppBar.astro';
import Footer from '../components/Footer.astro';
import '@fontsource-variable/inter/standard.css'; // latin+latin-ext 子集,Inter Variable
import '../tokens/theme.css';
import '../tokens/motion.css';
import '../styles/global.css';
import { site, repoUrl } from '../i18n/ui';
import { zh } from '../i18n/zh';
import { en } from '../i18n/en';
import release from '../data/release.json';
import { getImage } from 'astro:assets';
import heroShotLight from '../assets/screenshots/01-week-light.png';

// LCP preload(T3/T5,spec §2.6-8):hero 前景图 = 01-week 周视图(C1 首图不变量)。
// 参数必须与 Hero.astro 的 <Shot> 完全一致
// (同 widths/sizes/width/height → 同 transform hash → preload 命中浏览器缓存,零重复请求)。
// preloadHero 开关:仅两主页传 true;getImage 同条件化(非主页不产生构建期图像处理)。
const HERO_WIDTHS = [420, 840];
const HERO_SIZES = '(max-width: 840px) 88vw, 440px';

interface Props {
  lang: 'zh' | 'en';
  title: string;
  description: string;
  /** 本页 zh 规范路径,如 '/' · '/schools/'(canonical/hreflang/og:url 的基准) */
  path: string;
  /** 本页双语对里的对侧路径(en 主页传 '/', zh 主页传 '/en/';v5 多页化:恒指本页对,旧单页假设废弃) */
  mirror: string;
  /** 绝对 URL;缺省 = site + '/og/home-' + lang + '.png'(Task 8 OG 产出后各路由显式传) */
  ogImage?: string;
  ogImageAlt?: string;
  /** 缺省 false;仅两主页传 true(spec §2.6-8:工具页/FAQ/404 禁背死 preload) */
  preloadHero?: boolean;
  /** 缺省 false;两主页显式 true —— AppBar CTA 缺省态分支的输入,与 preloadHero 独立(终审 I2) */
  hasHero?: boolean;
  /** 缺省不发;主页传 SoftwareApplication 对象(Task 8 接线) */
  jsonLd?: object;
  /** 缺省不发 RSS link —— Task 8 建 /rss.xml 路由前挂上即断链(终审裁决) */
  rssLink?: string;
  /** 缺省 false;true → meta robots=noindex(spec §2.6-7:404 免收录;静态导出无 HTTP 头可设) */
  noindex?: boolean;
}

const { lang, title, description, path, mirror, ogImage, ogImageAlt, preloadHero, hasHero, jsonLd, rssLink, noindex } =
  Astro.props;
const copy = lang === 'zh' ? zh : en;
const ogLocale = lang === 'zh' ? 'zh_CN' : 'en_US';
const build = `${release.tag} · ${release.builtAt?.slice(0, 10) ?? ''}`;
const ogImg = ogImage ?? `${site}/og/home-${lang}.png`;
// 站级实体图(SEO 极致批次 S3a):WebSite + Organization 铺全部可收录页,
// 品牌搜索与知识面板的稳定锚;noindex 页(404)不发。页面级图经 jsonLd prop 另发。
const siteGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${site}/#website`,
      url: site,
      name: 'Sleepy',
      description: 'Official website of Sleepy (轻课表) — an offline-first university timetable app for Android.',
      inLanguage: ['zh-CN', 'en'],
    },
    {
      '@type': 'Organization',
      '@id': `${site}/#organization`,
      name: 'Sleepy',
      // alternateName 显式绑定中文品牌:AI 引擎对"Sleepy=轻课表"建同一实体的去歧义锚
      alternateName: ['轻课表'],
      url: site,
      // sameAs 多源:两应用仓 = 实体权威外链,E-E-A-T 信号 + GEO 实体归并
      sameAs: [repoUrl, 'https://github.com/lingion/sleepy-ios'],
      logo: { '@type': 'ImageObject', url: `${site}/apple-touch-icon.png`, width: 180, height: 180 },
    },
  ],
};
const heroImg = preloadHero
  ? await getImage({
      src: heroShotLight,
      widths: HERO_WIDTHS,
      sizes: HERO_SIZES,
      width: heroShotLight.width,
      height: heroShotLight.height,
    })
  : null;
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* ?v= 缓存破除(2026-10-27 圆角换代):浏览器 favicon 缓存按 URL 判等不回源,
        图标资产换代必须同时换 URL;升级图标时递增 v,禁回退到无查询串形态 */}
    <link rel="icon" href="/favicon.svg?v=1" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico?v=1" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=1" sizes="180x180" />
    {/* 404(noindex)不声明 canonical——指向他页与免收录信号矛盾(spec §2.6-7) */}
    {!noindex && <link rel="canonical" href={site + path} />}
    {noindex && <meta name="robots" content="noindex" />}
    {/* hreflang 恒指本页双语对(path/mirror 语义对),不再出现单页恒指 '/'(spec §2.6-2) */}
    <link rel="alternate" hreflang="zh-CN" href={site + (lang === 'zh' ? path : mirror)} />
    <link rel="alternate" hreflang="en" href={site + (lang === 'en' ? path : mirror)} />
    <link rel="alternate" hreflang="x-default" href={site + '/'} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sleepy" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={site + path} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={lang === 'zh' ? 'en_US' : 'zh_CN'} />
    {/* OG 大图三链(spec §2.6-1):值必为绝对 URL,爬虫不解析相对路径;缺省主页图保证永不为空 */}
    <meta property="og:image" content={ogImg} />
    {/* 全站 OG 图统一 1200x630(public/og 8 枚实测),尺寸先声明让爬虫省一次预取渲染 */}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt ?? title} />
    <meta name="twitter:image" content={ogImg} />
    <meta name="twitter:card" content="summary_large_image" />
    {/* 百度站长所有权验证(2026-10-28,HTML 标签方式):官方要求验证通过后保留,
        删除 = 站点掉出资源平台管辖且无告警,tests/baidu-verification.test.ts 锁令牌。 */}
    <meta name="baidu-site-verification" content="codeva-kA7BwrU2wy" />
    {/* Google Search Console 所有权验证(2026-10-28,替代方式 meta):与用户提供的
        DNS TXT 记录同令牌;官方要求验证通过后保留, 删除 = 站点掉出 GSC 管辖
        (收录状态/移除请求/安全报告全断)且无告警,tests/google-verification.test.ts 锁令牌。 */}
    <meta name="google-site-verification" content="l9EkNtXUntA_ZyNvr2f6GpYpTziiw-vSKOI3Sotl5aY" />
    {rssLink && <link rel="alternate" type="application/rss+xml" title="Sleepy release feed" href={rssLink} />}
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(siteGraph)} />}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <meta name="theme-color" content="#0F0D15" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#FDF8FF" media="(prefers-color-scheme: light)" />

    {/* LCP preload(T3):hero 前景图最早发现。imagesrcset+imagesizes 与 img 一致,
        浏览器按 srcset 选档预载,命中同一 transform hash 的缓存条目,零重复下载。
        preloadHero=false(工具页/FAQ/404)整块不产出——背着死 preload 违反 §0 基线(spec §2.6-8)。 */}
    {heroImg && (
      <link
        rel="preload"
        as="image"
        href={heroImg.src}
        imagesrcset={heroImg.srcSet.attribute}
        imagesizes={HERO_SIZES}
      />
    )}

    {/* FOUC 守卫(spec §1):首帧前读 localStorage 定 data-theme,无首屏闪变。
        is:inline = 不打包不延迟,这是唯一允许的内联脚本。 */}
    <script is:inline>
      (() => {
        document.documentElement.classList.add('js');
        try {
          const stored = localStorage.getItem('sleepy-theme');
          const dark = stored === 'dark' || (!stored && matchMedia('(prefers-color-scheme: dark)').matches);
          document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
        } catch {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{lang === 'zh' ? '跳到正文' : 'Skip to content'}</a>
    <AppBar lang={lang} copy={copy} hasHero={hasHero ?? false} mirror={mirror} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} build={build} copy={copy} mirror={mirror} />
    {/* 回顶浮标(2026-10-27 用户二次反馈:页脚链位置对「翻到一半回头」无效)。
        呈现=NN/g 九准则:右下固定 + 文字标签(纯图标有歧义) + 出现后静止;
        显隐=uxpatterns 细则:滚过一屏才浮出(短页永不出现)、fade 过渡、
        页脚入视即收起(到底时页脚 #top 链就在手边,浮标不再挡 meta 行)。
        默认 visibility:hidden = 无 JS 不显示空壳、不进 tab 序;页脚链保留为兜底。 */}
    <button type="button" class="back-to-top" data-back-to-top>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 3 19 10h-4.5v10h-5V10H5z"/>
      </svg>
      <span>{copy.footer.backToTop}</span>
    </button>
    <script>
      // 主题开关(lightbox 岛在 T6;此处只做 FOUC 之后的持久化 toggle)
      const root = document.documentElement;
      // 滚动揭示:IntersectionObserver 单例,DOM 序=揭示序(§2.4/§8 不变量)
      {
        const revealIO = new IntersectionObserver(
          (entries) => {
            for (const en of entries) {
              if (en.isIntersecting) {
                en.target.setAttribute('data-revealed', 'true');
                revealIO.unobserve(en.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px' },
        );
        document.querySelectorAll('.reveal').forEach((el) => revealIO.observe(el));
      }
      window.siteToggleTheme = () => {
        const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try {
          localStorage.setItem('sleepy-theme', next);
        } catch {}
        return next;
      };
      // 回顶浮标:滚过一屏且页脚未入视 → 浮现;点击 scrollTo({top:0})——
      // 平滑/即时交全局 html{scroll-behavior}(reduced-motion 自动降级),零内联行为覆写。
      // IO 盯页脚 = 到底即收(不挡 meta 行,且此刻页脚 #top 链已在手边)。
      {
        const btn = document.querySelector<HTMLButtonElement>('[data-back-to-top]');
        const footer = document.querySelector('footer.footer');
        if (btn && footer) {
          let footerInView = false;
          const sync = () => {
            btn.dataset.visible = String(window.scrollY > window.innerHeight && !footerInView);
          };
          new IntersectionObserver(([e]) => {
            footerInView = e.isIntersecting;
            sync();
          }).observe(footer);
          addEventListener('scroll', sync, { passive: true });
          sync();
          btn.addEventListener('click', () => window.scrollTo({ top: 0 }));
        }
      }
    </script>

  <style>
    .back-to-top {
      position: fixed;
      inset-block-end: calc(var(--site-unit) * 6);
      inset-inline-end: calc(var(--site-unit) * 6);
      z-index: 40; /* 内容浮层档:低于 AppBar(50),不与其抢位 */
      display: inline-flex;
      align-items: center;
      gap: calc(var(--site-unit) * 2);
      padding: calc(var(--site-unit) * 2.5) calc(var(--site-unit) * 4);
      border: none;
      border-radius: var(--md-sys-shape-corner-full);
      /* Filled 档(MD3 extended FAB 惯例)+ elevation-1 投影(光源正上方,§5.3 同款) */
      background: var(--md-sys-color-primary);
      color: var(--md-sys-color-on-primary);
      font: var(--md-sys-typescale-label-large);
      letter-spacing: 0.1px;
      cursor: pointer;
      box-shadow:
        0 1px 2px rgb(0 0 0 / 30%),
        0 2px 6px 2px rgb(0 0 0 / 15%);
      opacity: 0;
      visibility: hidden;
      transform: translateY(calc(var(--site-unit) * 2));
      transition:
        opacity var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-emphasized),
        transform var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-emphasized),
        visibility 0s linear var(--md-sys-motion-duration-short4);
    }
    .back-to-top[data-visible='true'] {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition:
        opacity var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-emphasized),
        transform var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-emphasized),
        visibility 0s;
    }
    @media (prefers-reduced-motion: reduce) {
      .back-to-top {
        transition: none;
        transform: none;
      }
    }
  </style>
  </body>
</html>
