---
import PageHeader from '../PageHeader.astro';
import release from '../../data/release.json';
import { repoUrl, sponsorUrl, onlineTrialUrl, iosTestFlightUrl, iosRepoUrl } from '../../i18n/ui';
import { downloadUrl } from '../../lib/download-source';
import type { DownloadSource } from '../../lib/download-source';
import type { SiteCopy } from '../../i18n/zh';

interface Props { copy: SiteCopy['downloadPage']; lang: 'zh' | 'en' }
const { copy: t, lang } = Astro.props;
const en = lang === 'en';
const source: DownloadSource = en ? 'github' : 'mirror';
const dl = en ? (await import('../../i18n/en')).en.download : (await import('../../i18n/zh')).zh.download;
const abiOf = (name: string) => name.replace(/^app-|-release\.apk$/g, '');
const mb = (bytes: number) => `${(bytes / 1024 / 1024).toFixed(1)} MB`;
const universal = release.assets.find(asset => asset.name.includes('universal'))!;
const notes = dl.abiNotes as Record<string, string>;
const versionLine = t.versionLine.replace('{tag}', release.tag).replace('{minSdk}', dl.minSdk).replace('{date}', release.date.slice(0, 10));
const sources = [
  { value: 'mirror', name: en ? 'Mirror' : '镜像下载', domain: 'gh.qdp.qzz.io', note: en ? 'Project mirror' : '项目镜像' },
  { value: 'github', name: 'GitHub', domain: 'github.com', note: en ? 'Original release' : '原始发布源' },
];
const statusMirror = en ? 'Files will download from gh.qdp.qzz.io.' : '当前通过 gh.qdp.qzz.io 下载安装包和校验文件。';
const statusGithub = en ? 'Files will download from github.com.' : '当前通过 github.com 下载安装包和校验文件。';
const badgeSrc = en ? '/badges/download-on-the-app-store-en.svg' : '/badges/download-on-the-app-store-zh.svg';
---

<section class="download-page" data-download-panel data-default-source={source}>
  <div class="site-col">
    <PageHeader title={t.heading} description={en ? 'Choose your platform and download source. Your timetable stays with you.' : '选择适合你的平台和下载方式，把课表带在身边。'}>
      <p slot="meta" class="download-page__versionline tnum">{versionLine}</p>
    </PageHeader>
    <div class="download-page__grid">
      <section class="download-page__package" aria-labelledby="dl-android">
        <header class="download-page__platform"><h2 id="dl-android" class="t-headline-medium">Android</h2><span class="t-label-large">{release.tag}</span></header>
        <fieldset class="download-source">
          <legend class="t-title-medium">{en ? 'Download source' : '下载来源'}</legend>
          <div class="download-source__options">
            {sources.map(option => <label class="download-source__option">
              <input type="radio" name="download-source" value={option.value} checked={source === option.value} aria-describedby="download-source-help" />
              <span class="download-source__text"><strong>{option.name}</strong><span translate="no">{option.domain}</span><small>{option.note}</small></span>
            </label>)}
          </div>
          <p id="download-source-help" class="download-source__help t-body-small">{en ? 'Both sources serve the GitHub release files. If one connection fails, try the other.' : '两种来源提供同一份 GitHub 发布文件，连接不畅时可切换。'}</p>
        </fieldset>
        <div class="download-page__primary">
          <div><h3 class="t-title-large">{en ? 'Universal APK' : 'Android 通用版'}</h3><p class="t-body-medium">{t.universalNote}</p></div>
          <a class="site-button site-button--elevated download-page__cta-xl" data-dl-primary data-download-official={universal.url} href={downloadUrl(universal.url, source)} download aria-label={`${en ? 'Download Android' : '下载 Android'} universal (${mb(universal.size)})`}>{en ? 'Download Android' : '下载 Android'}<span class="tnum">{mb(universal.size)}</span></a>
          <p class="download-source__status t-body-small" role="status" aria-live="polite" data-download-status data-mirror={statusMirror} data-github={statusGithub}>{source === 'mirror' ? statusMirror : statusGithub}</p>
        </div>
        <details class="download-page__architectures">
          <summary>{en ? 'Downloads for specific architectures' : '选择其他设备架构'}</summary>
          <ul class="download-page__list">
            {release.assets.map(asset => {
              const abi = abiOf(asset.name);
              return <li><a class="download-page__row" data-abi-row data-abi={abi} data-rec={abi === 'universal' || undefined} data-download-official={asset.url} href={downloadUrl(asset.url, source)} download aria-label={dl.downloadAria(abi, mb(asset.size))}>
                <span class="download-page__row-main"><span class="download-page__row-name" translate="no">{abi}</span><span class="download-page__row-note">{notes[abi]}</span></span>
                <span class="download-page__row-size tnum">{mb(asset.size)}<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M12 4v12m-5-5 5 5 5-5M5 20h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
              </a></li>;
            })}
          </ul>
        </details>
        <p class="download-page__release-link t-body-small"><a href={release.url}>{en ? 'Release notes on GitHub' : '在 GitHub 查看本版说明'}</a></p>
        <noscript>
          <p>{en ? 'JavaScript is off. Choose a direct link below:' : 'JavaScript 已关闭，可直接选择下方下载链接：'}</p>
          <ul>{[...release.assets, { name: 'sha256sums.txt', url: release.sha256sumsUrl }].map(asset => <li>{asset.name}: <a href={downloadUrl(asset.url, 'mirror')}>{en ? 'Mirror' : '镜像'}</a> / <a href={asset.url}>GitHub</a></li>)}</ul>
        </noscript>
      </section>
      <aside class="download-page__platforms" aria-label={en ? 'Other platforms' : '其他平台'}>
        <section class="download-platform" aria-labelledby="dl-ios">
          <h2 id="dl-ios" class="t-headline-small">iOS</h2>
          <span class="download-platform__label t-label-large">TestFlight</span>
          <p>{t.iosNote}</p>
          <a class="apple-store-badge-link" href={iosTestFlightUrl} target="_blank" rel="noopener noreferrer" aria-label={t.iosBadgeAria}><img class="apple-store-badge" src={badgeSrc} alt={t.iosBadgeAlt} width={en ? 120 : 109} height="40" loading="lazy" decoding="async" /></a>
          <a class="download-platform__source t-body-small" href={iosRepoUrl}>{en ? 'iOS source code' : 'iOS 源码'}</a>
        </section>
        <section class="download-platform" aria-labelledby="dl-web">
          <h2 id="dl-web" class="t-headline-small">{en ? 'Web' : '网页版'}</h2>
          <p>{dl.trial}</p>
          <a class="site-button site-button--outlined" data-role="trial" href={onlineTrialUrl} target="_blank" rel="noopener noreferrer">{en ? 'Open web app' : '打开网页版'}</a>
        </section>
      </aside>
    </div>

    <section class="download-help" aria-labelledby="dl-help">
      <h2 id="dl-help" class="t-headline-small">{en ? 'Installation and file checks' : '安装与文件校验'}</h2>
      <details open><summary>{t.installTitle}</summary><div class="download-help__body"><ol>{t.installSteps.map(step => <li>{step}</li>)}</ol><a href={en ? '/en/faq/#sec-2' : '/faq/#sec-2'}>{en ? 'Installation FAQ' : '查看安装常见问题'}</a></div></details>
      <details><summary>{t.verifyTitle}</summary><div class="download-help__body"><p>{t.verifyNote}</p><a data-download-official={release.sha256sumsUrl} href={downloadUrl(release.sha256sumsUrl, source)} download>{en ? 'Download SHA-256 checksums' : '下载 SHA-256 校验文件'}</a></div></details>
      <details><summary>{t.archTitle}</summary><div class="download-help__body"><table data-arch-table><tbody>
        <tr><th scope="row">arm64-v8a</th><td>{en ? 'Most recent Android phones' : '近年的 Android 手机'}</td></tr>
        <tr><th scope="row">armeabi-v7a</th><td>{en ? 'Older 32-bit devices' : '32 位老设备'}</td></tr>
        <tr><th scope="row">x86_64</th><td>{en ? 'Emulators' : '模拟器'}</td></tr>
      </tbody></table><p>{t.archNote}</p></div></details>
    </section>
    <nav class="download-page__more" aria-label={t.moreTitle}>
      <a href={`${repoUrl}/releases`}>{t.moreLinks.releases}</a><a href={repoUrl}>{t.moreLinks.repo}</a><a href={sponsorUrl}>{t.moreLinks.sponsor}</a><a href={`${repoUrl}/issues`}>{t.moreLinks.issues}</a>
    </nav>
  </div>
</section>

<script>
  import { applyDownloadSource } from '../../lib/download-source';
  import type { DownloadSource } from '../../lib/download-source';
  const panel = document.querySelector<HTMLElement>('[data-download-panel]');
  if (panel) {
    const query = new URLSearchParams(location.search);
    const selected = query.get('source');
    const initial = (selected === 'mirror' || selected === 'github' ? selected : panel.dataset.defaultSource) as DownloadSource;
    applyDownloadSource(panel, initial);
    panel.addEventListener('change', event => {
      const input = event.target as HTMLInputElement;
      if (input.name !== 'download-source' || !['mirror', 'github'].includes(input.value)) return;
      applyDownloadSource(panel, input.value as DownloadSource);
      const params = new URLSearchParams(location.search);
      params.set('source', input.value);
      history.replaceState(null, '', `${location.pathname}?${params}${location.hash}`);
    });
    addEventListener('popstate', () => {
      const source = new URLSearchParams(location.search).get('source');
      applyDownloadSource(panel, source === 'mirror' || source === 'github' ? source : panel.dataset.defaultSource as DownloadSource);
    });
  }
</script>

<style>
  .download-page { padding-block: clamp(40px, 7vw, 80px) 80px; }
  .download-page__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 24px; align-items: start; }
  .download-page__package { min-inline-size: 0; padding: clamp(20px, 4vw, 32px); border-radius: var(--md-sys-shape-corner-xl); background: var(--md-sys-color-primary-container); color: var(--md-sys-color-on-primary-container); }
  .download-page__platform { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-block-end: 28px; }
  .download-page[data-source] .download-source { display: block; }
  .download-source { display: none; border: 0; padding: 0; margin: 0; min-inline-size: 0; }
  .download-source legend { margin-block-end: 16px; }
  .download-source__options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .download-source__option { position: relative; display: flex; align-items: start; gap: 12px; padding: 20px 16px; border: 2px solid transparent; border-radius: var(--md-sys-shape-corner-large); background: color-mix(in srgb, var(--md-sys-color-surface) 72%, var(--md-sys-color-primary-container)); color: var(--md-sys-color-on-surface); cursor: pointer; touch-action: manipulation; }
  .download-source__option:has(:checked) { border-color: var(--md-sys-color-primary); background: var(--md-sys-color-surface); }
  .download-source__option:has(:focus-visible) { outline: 3px solid var(--md-sys-color-primary); outline-offset: 3px; }
  .download-source__option input { margin: 3px 0 0; inline-size: 20px; block-size: 20px; flex-shrink: 0; accent-color: var(--md-sys-color-primary); }
  .download-source__text { display: grid; gap: 8px; min-inline-size: 0; }
  .download-source__text strong { font: var(--md-sys-typescale-title-medium); }
  .download-source__text :is(span, small) { font: var(--md-sys-typescale-body-small); line-height: 1.5; overflow-wrap: anywhere; color: var(--md-sys-color-on-surface-variant); }
  .download-source__help { margin-block-start: 16px; line-height: 1.7; }
  .download-page__primary { display: grid; gap: 16px; padding-block: 32px 24px; }
  .download-page__primary h3 { margin-block-end: 8px; }
  .download-page__primary p { line-height: 1.7; }
  .download-page__cta-xl { inline-size: 100%; justify-content: center; flex-wrap: wrap; gap: 12px; min-block-size: 56px; padding: 16px 24px; font-size: 16px; text-decoration: none; }
  .download-page__cta-xl span { font: var(--md-sys-typescale-label-large); }
  .download-source__status { min-block-size: 2.8em; overflow-wrap: anywhere; }
  .download-page__architectures { border-block-start: 1px solid color-mix(in srgb, currentColor 24%, transparent); }
  .download-page__architectures summary, .download-help summary { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 20px 0; min-block-size: 60px; cursor: pointer; font: var(--md-sys-typescale-title-medium); list-style: none; }
  :is(.download-page__architectures, .download-help) summary::-webkit-details-marker { display: none; }
  :is(.download-page__architectures, .download-help) summary::after { content: ''; inline-size: 8px; block-size: 8px; border-inline-end: 2px solid; border-block-end: 2px solid; transform: rotate(45deg); flex-shrink: 0; margin-inline: 4px; }
  :is(.download-page__architectures, .download-help) details[open] > summary::after, .download-page__architectures[open] > summary::after { transform: rotate(225deg); }
  .download-page__list { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .download-page__row { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 16px; border-radius: var(--md-sys-shape-corner-medium); background: var(--md-sys-color-surface); color: var(--md-sys-color-on-surface); text-decoration: none; }
  .download-page__row:active { background: color-mix(in srgb, currentColor 10%, var(--md-sys-color-surface)); }
  .download-source__option:active { background: color-mix(in srgb, currentColor 10%, var(--md-sys-color-surface)); }
  .download-page__row-main { display: grid; gap: 4px; min-inline-size: 0; }
  .download-page__row-name { font: var(--md-sys-typescale-title-small); }
  .download-page__row-note { font: var(--md-sys-typescale-body-small); color: var(--md-sys-color-on-surface-variant); line-height: 1.5; }
  .download-page__row-size { display: flex; align-items: center; gap: 12px; flex-shrink: 0; font: var(--md-sys-typescale-body-small); }
  .download-page__release-link { margin-block-start: 20px; }
  .download-page__package a:not(.site-button, .download-page__row) { color: inherit; }
  .download-page__platforms { display: grid; gap: 24px; min-inline-size: 0; }
  .download-platform { padding: clamp(20px, 4vw, 32px); background: var(--md-sys-color-surface-container-low); border-radius: var(--md-sys-shape-corner-xl); display: grid; justify-items: start; gap: 16px; }
  .download-platform p { font: var(--md-sys-typescale-body-medium); line-height: 1.8; color: var(--md-sys-color-on-surface-variant); }
  .download-platform__label { margin-block-start: -8px; color: var(--md-sys-color-primary); }
  .apple-store-badge-link { display: inline-flex; align-items: center; min-block-size: 44px; border-radius: 8px; }
  .apple-store-badge { display: block; block-size: 40px; inline-size: auto; }
  .download-platform__source { display: inline-flex; align-items: center; min-block-size: 44px; }
  .download-help { max-inline-size: 760px; margin-block: 64px 32px; }
  .download-help h2 { margin-block-end: 24px; }
  .download-help details { border-block-end: 1px solid var(--md-sys-color-outline-variant); }
  .download-help__body { display: grid; gap: 20px; padding-block: 0 24px; color: var(--md-sys-color-on-surface-variant); line-height: 1.8; }
  .download-help__body ol { padding-inline-start: 24px; display: grid; gap: 12px; }
  .download-help__body table { border-collapse: collapse; inline-size: 100%; font-size: 14px; }
  .download-help__body th, .download-help__body td { text-align: start; vertical-align: top; padding: 8px 16px 8px 0; }
  .download-page__more { display: flex; flex-wrap: wrap; gap: 8px 24px; }
  .download-page__more a { display: inline-flex; align-items: center; min-block-size: 44px; }
  @media (hover: hover) and (pointer: fine) {
    .download-page__row:hover { background: color-mix(in srgb, currentColor 8%, var(--md-sys-color-surface)); }
    .download-source__option:hover { border-color: var(--md-sys-color-primary); }
  }
  @media (min-width: 900px) { .download-page__grid { grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr); gap: 32px; } }
  @media (max-width: 600px) {
    .download-source__option { padding: 16px 12px; gap: 8px; }
    .download-source__text small { display: none; }
  }
  @media (max-width: 400px) {
    .download-source__options { grid-template-columns: minmax(0, 1fr); }
    .download-source__option { padding: 16px; }
    .download-source__text { grid-template-columns: minmax(0, 1fr); gap: 4px; }
    .download-source__text small { display: none; }
    .download-page__row { padding: 16px 12px; gap: 8px; }
    .download-page__row-size { gap: 4px; }
  }
</style>
