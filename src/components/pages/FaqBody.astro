---
// Full answers and original anchors remain in the static HTML.
import PageHeader from '../PageHeader.astro';
import DocumentNav from '../DocumentNav.astro';
import faq from '../../data/faq.json';
import { qqGroup, repoUrl } from '../../i18n/ui';
import type { SiteCopy } from '../../i18n/zh';

interface Props {
  copy: SiteCopy['faqPage'];
  lang: 'zh' | 'en';
}
const { copy: t, lang } = Astro.props;

type Inline = { t: 'text'; v: string } | { t: 'code'; v: string } | { t: 'bold'; v: string } | { t: 'link'; href: string; inline?: Inline[] };
type Block =
  | { type: 'paragraph'; inline: Inline[] }
  | { type: 'list'; ordered: boolean; items: Inline[][] }
  | { type: 'pre'; lang?: string; text: string };

const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

function inlineToHtml(parts: Inline[] | undefined): string {
  return (parts ?? [])
    .map((i) => {
      if (i.t === 'code') return `<code>${esc(i.v)}</code>`;
      if (i.t === 'bold') return `<strong>${esc(i.v)}</strong>`;
      if (i.t === 'link') {
        const href = esc(i.href);
        const rel = /^(https?:)?\/\//.test(i.href) ? ' rel="noopener noreferrer" target="_blank"' : '';
        return `<a href="${href}"${rel}>${inlineToHtml(i.inline)}</a>`;
      }
      return esc(i.v);
    })
    .join('');
}

function blockToHtml(b: Block): string {
  if (b.type === 'pre') return `<pre translate="no" class="faq__pre"><code>${esc(b.text)}</code></pre>`;
  if (b.type === 'list') {
    const tag = b.ordered ? 'ol' : 'ul';
    return `<${tag} class="faq__list">${b.items.map((li) => `<li>${inlineToHtml(li)}</li>`).join('')}</${tag}>`;
  }
  return `<p class="faq__p">${inlineToHtml(b.inline)}</p>`;
}

const secAnchor = (i: number) => `sec-${i + 1}`;
// faq.json 的 import 推断把 type/t 放宽为 string,在边界 cast 成本文件类型(结构由 build-faq 闸锁)
const rendered = faq.sections.map((s, i) => ({
  id: secAnchor(i),
  name: s[lang],
  items: s.items.map((it) => ({ id: it.id, q: it.q[lang], body: (it.a[lang] as Block[]).map(blockToHtml).join('') })),
}));
const zhUI = lang === 'zh';
---

<div class="faq-page document-page" data-faq-page>
  <div class="site-col">
    <PageHeader title={t.heading} description={t.sub} />
    <div class="faq__search">
      <label><span class="t-label-large">{zhUI ? '搜索常见问题' : 'Search questions and answers'}</span><input class="site-field" data-faq-search type="search" name="q" autocomplete="off" placeholder={zhUI ? '输入关键词，如导入、备份、安装…' : 'Try import, backup or installation…'} aria-controls="faq-results" /></label>
      <div class="faq__search-status"><p class="t-body-small" role="status" aria-live="polite" data-faq-count={zhUI ? '找到 {count} 个问题' : '{count} questions found'}></p><button class="site-button site-button--text" data-faq-clear type="button" hidden>{zhUI ? '清空搜索' : 'Clear search'}</button></div>
    </div>
    <div class="document-grid">
      <DocumentNav label={t.tocLabel} links={rendered.map(section => ({href: `#${section.id}`, label: section.name}))} />
      <div class="faq__body" id="faq-results">
        <p class="faq__review t-body-small">{zhUI ? '问答保留其核对日期，最新版本的变化请查看' : 'For changes since the FAQ review date, see the'}{' '}<a href={zhUI ? '/releases/' : '/en/releases/'}>{zhUI ? '更新说明' : 'release notes'}</a>{zhUI ? '。' : '.'}</p>
        {rendered.map(section => <section class="faq__section" data-faq-section data-section={section.name} id={section.id}>
          <h2 class="t-title-large faq__section-title">{section.name}</h2>
          {section.items.map(item => <article class="faq__item" data-faq-item id={item.id}>
            <details><summary><h3 class="t-title-medium faq__q">{item.q}</h3><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></summary><div class="faq__a" set:html={item.body} /></details>
          </article>)}
        </section>)}
        <div class="faq__empty" data-faq-empty hidden><h2 class="t-title-large">{zhUI ? '没有找到匹配的问题' : 'No matching questions'}</h2><p>{zhUI ? '试试更短的关键词，或清空搜索浏览全部问答。' : 'Try a shorter keyword or clear the search to browse all answers.'}</p></div>
        <footer class="faq__tail" aria-label={t.tailTitle}>
          <h2 class="t-title-medium">{t.tailTitle}</h2>
          <div class="faq__tail-links t-body-medium"><a href={`${repoUrl}/issues`} rel="noopener noreferrer" target="_blank">{t.tailIssues}</a><a href={`${repoUrl}/discussions`} rel="noopener noreferrer" target="_blank">{t.tailDiscussions}</a><span>{zhUI ? 'QQ 群' : 'QQ group'} {qqGroup}</span></div>
          <p class="t-body-small faq__updated tnum">{t.updatedPrefix} {faq.updatedAt}</p>
        </footer>
      </div>
    </div>
  </div>
</div>

<style>
  .faq__search { display: none; margin-block-end: 40px; padding: 24px; border-radius: var(--md-sys-shape-corner-xl); background: var(--md-sys-color-surface-container-low); }
  .faq-page[data-enhanced] .faq__search { display: grid; gap: 8px; }
  .faq__search label { display: grid; gap: 12px; }
  .faq__search input { inline-size: 100%; min-inline-size: 0; min-block-size: 56px; border-radius: var(--md-sys-shape-corner-large); background: var(--md-sys-color-surface); }
  .faq__search-status { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; min-block-size: 44px; color: var(--md-sys-color-on-surface-variant); }
  .faq__body { min-inline-size: 0; max-inline-size: 72ch; }
  .faq__review { line-height: 1.8; margin-block-end: 32px; color: var(--md-sys-color-on-surface-variant); }
  .faq__section { margin-block-end: 40px; scroll-margin-block-start: 100px; }
  .faq__section-title { margin-block-end: 20px; }
  .faq__item { scroll-margin-block-start: 100px; margin-block-end: 12px; }
  .faq__item details { border-radius: var(--md-sys-shape-corner-large); background: var(--md-sys-color-surface-container-low); overflow: clip; }
  .faq__item summary { display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 20px 24px; min-block-size: 64px; cursor: pointer; list-style: none; touch-action: manipulation; }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__q { line-height: 1.7; }
  .faq__item summary svg { flex-shrink: 0; color: var(--md-sys-color-primary); }
  .faq__item details[open] summary svg { transform: rotate(180deg); }
  .faq__item summary:active { background: color-mix(in srgb, currentColor 10%, transparent); }
  .faq__a { display: grid; gap: 12px; padding: 0 24px 24px; font-size: 16px; line-height: 1.8; overflow-wrap: anywhere; color: var(--md-sys-color-on-surface-variant); }
  /* set:html children do not receive Astro scoped attributes. */
  .faq__a :global(:is(p, ul, ol)) { margin: 0; }
  .faq__a :global(a) { color: var(--md-sys-color-primary); }
  .faq__a :global(.faq__pre) { margin: 0; padding: 16px; border-radius: var(--md-sys-shape-corner-small); background: var(--md-sys-color-surface-container); color: var(--md-sys-color-on-surface); overflow-x: auto; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; line-height: 1.6; }
  .faq__a :global(.faq__list) { padding-inline-start: 1.4em; }
  .faq__empty { display: grid; gap: 16px; padding-block: 24px 48px; line-height: 1.8; }
  .faq__tail { border-block-start: 1px solid var(--md-sys-color-outline-variant); padding-block-start: 24px; display: grid; gap: 16px; }
  .faq__tail-links { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 24px; }
  .faq__tail-links a { display: inline-flex; align-items: center; min-block-size: 44px; }
  .faq__updated { color: var(--md-sys-color-on-surface-variant); }
  @media (hover: hover) and (pointer: fine) { .faq__item summary:hover { background: color-mix(in srgb, currentColor 8%, transparent); } }
  @media (max-width: 600px) { .faq__search { padding: 20px; } .faq__item summary { padding: 16px 20px; gap: 16px; } .faq__a { padding: 0 20px 20px; } }
</style>
<script>
  import { enhanceFaq } from '../../lib/faq-search';
  enhanceFaq(document);
</script>
