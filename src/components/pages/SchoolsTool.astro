---
import PageHeader from '../PageHeader.astro';
import typesEn from '../../data/types-en.json';
import { repoUrl } from '../../i18n/ui';
import type { SiteCopy } from '../../i18n/zh';
import { searchFace } from '../../lib/search';
import { catalogUpdatedAt, provincesOrdered, rowCount, schools, typesOrdered } from '../../lib/schools-view';

interface Props { copy: SiteCopy['schoolsPage']; lang: 'zh' | 'en' }
const { copy: t, lang } = Astro.props;
const en = lang === 'en';
const groups = provincesOrdered().map(province => ({ ...province, label: en ? province.en : province.zh, rows: schools.filter(school => school.province.code === province.code) }));
const typeLabel = (type: string) => en ? (typesEn as Record<string, string>)[type] ?? type : type;
const adaptationUrl = `${repoUrl}/issues/new?template=school_adaptation.yml`;
const progress = en ? 'Showing {shown} of {matched} matches' : '已显示 {shown} / {matched} 所';
---

<section class="schools-page">
  <div class="site-col">
    <PageHeader title={t.heading} description={t.sub} />
    <div class="schools__filters js-only">
      <div class="schools__toolbar">
        <label class="schools__search">
          <span class="t-label-large">{t.searchLabel}</span>
          <input class="site-field" type="search" name="q" spellcheck="false" data-role="q" placeholder={t.placeholder} autocomplete="off" aria-controls="school-results" />
        </label>
        <label class="schools__province">
          <span class="t-label-large">{t.provinceLabel}</span>
          <select class="site-select" name="province" data-role="province" aria-label={t.provinceAria} aria-controls="school-results">
            <option value="">{en ? 'All regions' : '全部地区'}</option>
            {groups.map(group => <option value={group.code}>{group.label}</option>)}
          </select>
        </label>
      </div>
      <details class="schools__advanced" data-school-advanced>
        <summary>{en ? 'More filters' : '更多筛选'}</summary>
        <label class="schools__protocol">
          <span class="t-label-large">{t.typeLabel}</span>
          <select class="site-select" name="protocol" data-role="type" aria-label={t.typeAria} aria-controls="school-results">
            <option value="">{en ? 'All academic systems' : '全部教务系统'}</option>
            {typesOrdered().map(type => <option value={type}>{typeLabel(type)}</option>)}
          </select>
        </label>
      </details>
    </div>

    <div class="schools__result-head">
      <h2 class="t-title-large">{en ? 'School directory' : '学校名录'}</h2>
      <p class="schools__stat t-body-medium tnum" role="status" aria-live="polite" data-shown-tpl={t.countShown}>{t.countShown.replace('{matched}', String(rowCount))}</p>
      <button class="site-button site-button--text" type="button" data-role="reset" hidden>{en ? 'Reset filters' : '重置筛选'}</button>
    </div>
    <div class="schools__groups" data-role="groups" id="school-results">
      {groups.map(group => <details class="schools__group" data-group={group.code}>
        <summary class="schools__summary t-title-medium">{group.label}<span class="schools__count tnum">{group.rows.length}</span></summary>
        <ul class="schools__list">
          {group.rows.map(school => {
            const unverified = school.status === 'unverified' || school.status === 'grad_unverified';
            return <li class="schools__row" data-school data-province={group.code} data-type={school.type} data-catalog-id={school.catalogId} data-status={school.status} data-search={searchFace(school)}>
              <div class="schools__identity"><span class="schools__name t-title-medium">{school.name}</span><span class="schools__meta t-body-small">{group.label}</span></div>
              <span class="schools__status t-label-medium" data-unverified={unverified || undefined}>{unverified ? (en ? 'Unverified' : '待验证') : (en ? 'Configured' : '已适配')}</span>
            </li>;
          })}
        </ul>
      </details>)}
    </div>
    <div class="schools__empty" data-role="empty" hidden>
      <h3 class="t-title-large">{en ? 'No matching schools' : '没有找到匹配的学校'}</h3>
      <p>{en ? 'Try a shorter school name or remove the region and system filters.' : '可以缩短校名，或重置地区与教务系统后再试。'}</p>
      <a class="site-button site-button--tonal" href={adaptationUrl}>{t.emptyCta}</a>
    </div>
    <div class="schools__pagination js-only">
      <p class="t-body-small tnum" data-progress-tpl={progress}></p>
      <button class="site-button site-button--outlined" type="button" data-role="more" hidden>{en ? 'Show more schools' : '显示更多学校'}</button>
    </div>
    <footer class="schools__foot">
      <p class="t-body-small">{t.footUpdated} <time>{catalogUpdatedAt}</time> · {t.footNote}</p>
      <p class="t-body-medium">{t.emptyTitle}</p>
      <a class="site-button site-button--text" href={adaptationUrl}>{t.emptyCta}</a>
      <noscript><p>{en ? 'Open a region to browse the complete directory.' : '展开地区即可浏览完整学校名录。'}</p></noscript>
    </footer>
  </div>
</section>

<script>
  import { applyInitialState, parseUrlState, schoolPageSize } from '../../lib/schools-island';
  const page = document.querySelector<HTMLElement>('.schools-page');
  if (page) {
    const input = page.querySelector<HTMLInputElement>('[data-role="q"]')!;
    const province = page.querySelector<HTMLSelectElement>('[data-role="province"]')!;
    const type = page.querySelector<HTMLSelectElement>('[data-role="type"]')!;
    const advanced = page.querySelector<HTMLDetailsElement>('[data-school-advanced]')!;
    const groups = [...page.querySelectorAll<HTMLDetailsElement>('[data-group]')];
    const more = page.querySelector<HTMLButtonElement>('[data-role="more"]')!;
    let limit = schoolPageSize;
    const render = () => {
      applyInitialState(document, location.search, limit);
      for (const group of groups) group.open = !group.hidden;
      if (parseUrlState(location.search).type) advanced.open = true;
    };
    const change = (key: string, value: string, push: boolean) => {
      const params = new URLSearchParams(location.search);
      if (value) params.set(key, value); else params.delete(key);
      const query = params.toString();
      history[push ? 'pushState' : 'replaceState'](null, '', `${location.pathname}${query ? `?${query}` : ''}`);
      limit = schoolPageSize;
      render();
    };
    const initial = new URLSearchParams(location.search);
    if (initial.get('focus') === 's') {
      initial.delete('focus');
      history.replaceState(null, '', `${location.pathname}${initial.size ? `?${initial}` : ''}`);
      input.focus();
    }
    render();
    page.dataset.enhanced = "";
    input.addEventListener('input', () => change('q', input.value, false));
    province.addEventListener('change', () => change('p', province.value, true));
    type.addEventListener('change', () => change('t', type.value, true));
    page.querySelector('[data-role="reset"]')!.addEventListener('click', () => {
      history.pushState(null, '', location.pathname);
      limit = schoolPageSize;
      render();
      input.focus();
    });
    more.addEventListener('click', () => {
      const before = new Set(page.querySelectorAll('[data-school]:not([hidden])'));
      limit += schoolPageSize;
      render();
      const firstNew = [...page.querySelectorAll<HTMLElement>('[data-school]:not([hidden])')].find(row => !before.has(row));
      if (firstNew) { firstNew.tabIndex = -1; firstNew.focus(); }
    });
    window.addEventListener('popstate', () => { limit = schoolPageSize; render(); });
  }
</script>

<style>
  .schools-page { padding-block: clamp(40px, 7vw, 80px) 80px; }
  .schools__filters, .schools__pagination { display: none; }
  .schools-page[data-enhanced] .schools__filters, .schools-page[data-enhanced] .schools__pagination { display: grid; }
  .schools__filters { padding: clamp(20px, 4vw, 32px); border-radius: var(--md-sys-shape-corner-xl); background: var(--md-sys-color-surface-container-low); }
  .schools__toolbar { display: grid; grid-template-columns: minmax(0, 1fr) 200px; gap: 24px; align-items: end; }
  .schools__search, .schools__province, .schools__protocol { display: grid; gap: 12px; min-inline-size: 0; }
  .schools__search input, .schools__province select, .schools__protocol select { inline-size: 100%; min-inline-size: 0; min-block-size: 56px; border-radius: var(--md-sys-shape-corner-large); font-size: 16px; background-color: var(--md-sys-color-surface); color: var(--md-sys-color-on-surface); }
  .site-select { border: 1px solid var(--md-sys-color-outline); padding: 12px 16px; font-family: inherit; }
  .schools__advanced { margin-block-start: 16px; }
  .schools__advanced summary { display: inline-flex; align-items: center; gap: 12px; min-block-size: 44px; padding: 8px 16px; margin-inline-start: -16px; border-radius: var(--md-sys-shape-corner-full); color: var(--md-sys-color-primary); cursor: pointer; touch-action: manipulation; font: var(--md-sys-typescale-label-large); list-style: none; }
  .schools__advanced summary::-webkit-details-marker { display: none; }
  .schools__advanced summary::after { content: ''; inline-size: 7px; block-size: 7px; border-inline-end: 2px solid; border-block-end: 2px solid; transform: rotate(45deg); margin-block-end: 4px; }
  .schools__advanced[open] summary::after { transform: rotate(225deg); margin-block-end: -4px; }
  .schools__advanced summary:active { background: color-mix(in srgb, currentColor 10%, transparent); }
  .schools__protocol { padding-block-start: 12px; max-inline-size: 560px; }
  .schools__result-head { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 20px; margin-block: 40px 16px; }
  .schools__stat { color: var(--md-sys-color-on-surface-variant); }
  .schools__result-head button { margin-inline-start: auto; }
  .schools__groups { min-inline-size: 0; }
  .schools__group { content-visibility: auto; contain-intrinsic-size: auto 64px; }
  .schools__summary { display: flex; align-items: center; gap: 12px; min-block-size: 56px; padding: 12px 4px; cursor: pointer; touch-action: manipulation; color: var(--md-sys-color-primary); }
  .schools__count { font: var(--md-sys-typescale-label-medium); color: var(--md-sys-color-on-surface-variant); }
  .schools__list { list-style: none; padding: 0; margin: 0; }
  .schools__row { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 20px 8px; border-block-end: 1px solid var(--md-sys-color-outline-variant); }
  .schools__identity { display: grid; gap: 8px; min-inline-size: 0; }
  .schools__name { line-height: 1.5; }
  .schools__meta { color: var(--md-sys-color-on-surface-variant); overflow-wrap: anywhere; line-height: 1.6; }
  .schools__status { flex-shrink: 0; padding: 6px 12px; border-radius: var(--md-sys-shape-corner-full); background: var(--md-sys-color-secondary-container); color: var(--md-sys-color-on-secondary-container); }
  .schools__status[data-unverified] { background: var(--md-sys-color-surface-container); color: var(--md-sys-color-on-surface-variant); }
  .schools__empty { display: grid; justify-items: start; gap: 16px; padding-block: 32px; }
  .schools__empty p { color: var(--md-sys-color-on-surface-variant); line-height: 1.8; }
  .schools__pagination { display: grid; justify-items: center; gap: 16px; margin-block: 32px 48px; color: var(--md-sys-color-on-surface-variant); }
  .schools__foot { display: grid; justify-items: start; gap: 12px; padding-block-start: 24px; border-block-start: 1px solid var(--md-sys-color-outline-variant); color: var(--md-sys-color-on-surface-variant); }
  .schools-page[data-enhanced] .schools__summary { display: none; }
  @media (max-width: 600px) {
    .schools__toolbar { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    .schools__row { align-items: start; gap: 12px; padding: 20px 0; }
    .schools__status { font-size: 12px; padding: 6px 8px; margin-block-start: 2px; }
    .schools__result-head { margin-block-start: 32px; }
  }
</style>
