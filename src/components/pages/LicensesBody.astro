---
import credits from '../../data/licenses.json';
import PageHeader from '../PageHeader.astro';
import DocumentNav from '../DocumentNav.astro';

interface Props { lang: 'zh' | 'en' }
const { lang } = Astro.props;
const english = lang === 'en';
const copy = english ? {
  title: 'Open source licenses and acknowledgements',
  intro: 'The people, projects and source materials behind Sleepy.',
  license: 'License', contributors: 'Contributors', sources: 'Sources and references',
  history: 'Earlier acknowledgements', schools: 'School projects',
  notice: 'Original licenses and notices', full: 'Full earlier statement',
  research: 'Research references do not imply code reuse or integration. Third party material retains its own license and attribution.',
  unresolved: 'Earlier reviews also named these projects without identifying a unique repository:',
  unverified: 'Historical link not confirmed at the recorded audit.',
  download: 'Download the complete source inventory',
} : {
  title: '开源许可与致谢', intro: '感谢为 Sleepy 提供代码、素材和公开资料的作者与维护者。',
  license: '许可证', contributors: '贡献者', sources: '来源与研究参考',
  history: '历史致谢', schools: '按学校致谢', notice: '许可与声明原文',
  full: '历史完整声明', research: '调研参考不表示复用源码或已经集成。第三方源码、素材和数据保留各自的许可与署名。',
  unresolved: '原调研还记录了以下简称，但没有足够信息确定具体仓库：',
  unverified: '记录的核对日期未确认此历史链接。',
  download: '下载完整来源清单',
};
const locale = english ? 'values-en' : 'values';
const legacy = credits.legacy.locales[locale];
const labels = credits.labels[locale];
---

<div class="site-col document-page credits">
  <PageHeader title={copy.title} description={copy.intro}>
    <span slot="meta" class="site-chip">GPL-3.0</span>
    <a slot="actions" class="site-button site-button--tonal" href="/licenses/inventory.json" download>{copy.download}</a>
  </PageHeader>
  <div class="document-grid">
    <DocumentNav label={english ? 'On this page' : '本页内容'} links={[
      { href: '#license', label: copy.license },
      { href: '#contributors', label: copy.contributors },
      { href: '#sources', label: copy.sources },
      { href: '#history', label: copy.history },
    ]} />
    <article class="document-body">
  <section id="license" aria-labelledby="license-heading">
    <h2 id="license-heading">{copy.license}</h2>
    <p>{legacy.license_gpl_body}</p>
    <p>{labels.notice}</p>
    <h3>{copy.notice}</h3>
    <ul class="notice-list">
      <li><a href="/licenses/notices/Sleepy-GPL-3.0.txt">Sleepy <span>GPL-3.0</span></a></li>
      {credits.manifest.notices.map(notice => <li><a href={`/licenses/notices/${notice.path}`}>{notice.path.split('/').at(-1)?.replace(/\.(txt|md)$/, '')}</a></li>)}
    </ul>
  </section>
  <section id="contributors" aria-labelledby="contributors-heading">
    <h2 id="contributors-heading">{copy.contributors}</h2>
    <ul class="contributors">
      {credits.legacy.contributors.map(entry => <li><a class="site-chip" href={`https://github.com/${entry.id.slice('contributor-'.length)}`}>{entry.title}</a></li>)}
    </ul>
  </section>
  <section id="sources" aria-labelledby="sources-heading">
    <h2 id="sources-heading">{copy.sources}</h2>
    <p>{copy.research}</p>
    {credits.manifest.groups.map((group, index) => <details open={index === 0}>
      <summary>{labels.groups[index]}</summary>
      <ul class="sources">
        {credits.manifest.entries.filter(entry => entry.group === group).map(entry => <li>
          <a href={entry.url}>{entry.project}</a>
          <p class="source-meta">{entry.author} · {entry.license}</p>
          <p>{entry.usage}</p>
          {entry.verification.status === 'unverified' && <p>{copy.unverified}</p>}
        </li>)}
      </ul>
    </details>)}
    <p>{copy.unresolved} {credits.manifest.unresolved_names.join(', ')}{english ? '.' : '。'}</p>
  </section>
  <section id="history" aria-labelledby="history-heading">
    <h2 id="history-heading">{copy.history}</h2>
    {credits.legacy.foundational.map(entry => <details>
      <summary>{entry.title}</summary>
      <p>{entry.meta}</p><p class="preserve-lines">{entry.usage}</p>
    </details>)}
    <h3>{copy.schools}</h3>
    {credits.legacy.schools.map(entry => <details>
      <summary>{entry.title}</summary><p class="preserve-lines">{entry.usage}</p>
    </details>)}
    <details><summary>{copy.full}</summary><p class="preserve-lines">{legacy.about_license_body}</p>
      {'additional_history' in legacy && <p class="preserve-lines">{legacy.additional_history}</p>}
    </details>
  </section>
    </article>
  </div>
</div>

<style>
  .contributors, .notice-list { list-style: none; padding: 0; margin-block: calc(var(--site-unit) * 5); }
  .contributors { display: flex; flex-wrap: wrap; gap: calc(var(--site-unit) * 3); }
  .contributors li + li { margin: 0; }
  .contributors a { text-decoration: none; }
  .notice-list { display: grid; grid-template-columns: minmax(0, 1fr); gap: calc(var(--site-unit) * 2); }
  .notice-list li + li { margin: 0; }
  .notice-list a { display: flex; align-items: center; flex-wrap: wrap; justify-content: space-between; gap: calc(var(--site-unit) * 2); min-block-size: 52px; padding: calc(var(--site-unit) * 4); background: var(--md-sys-color-surface-container); border-radius: var(--md-sys-shape-corner-medium); font: var(--md-sys-typescale-label-large); text-decoration: none; }
  .notice-list span { color: var(--md-sys-color-on-surface-variant); }
  .sources { list-style: none; padding: 0; }
  .sources li { padding-block: calc(var(--site-unit) * 5); }
  .sources li + li { border-block-start: 1px solid var(--md-sys-color-outline-variant); margin: 0; }
  .sources li > a { font: var(--md-sys-typescale-title-medium); display: inline-block; padding-block: calc(var(--site-unit) * 2); }
  .sources p { font: var(--md-sys-typescale-body-medium); line-height: 1.7; color: var(--md-sys-color-on-surface-variant); }
  .source-meta { margin-block: calc(var(--site-unit) * 2); }
  .preserve-lines { white-space: pre-wrap; font: var(--md-sys-typescale-body-medium); line-height: 1.8; }
</style>
