---
// v4 AppBar(spec §4):三段式 = 品牌标 / 4 枚锚点文字链(Text 档,≤840px 隐藏)/ [下载]Filled S + 语言 + 主题
// 滚动态 surface→surface-container tonal 升起(仅 background-color 150ms,无投影);高 64px
// 互隐 IO(T6,spec §11-6):hero 在视口 → appbar CTA hide;离开 → show。缺省 show = JS-off 必显。
// 锚点串走 appbar.anchors 键树(zh/en 同形,禁 ternary 硬编码);label 走 aria-label 键。
import { zh } from '../i18n/zh';
import type { SiteCopy } from '../i18n/zh';

interface Props {
  lang: 'zh' | 'en';
  copy?: SiteCopy;
}
const { lang } = Astro.props;
const c = Astro.props.copy ?? zh;
const other = lang === 'zh' ? '/en/' : '/';
const otherLabel = lang === 'zh' ? 'EN' : '中文';
const anchors = [
  { href: '#views', label: c.appbar.anchors.views },
  { href: '#schools', label: c.appbar.anchors.schools },
  { href: '#reminders', label: c.appbar.anchors.reminders },
  { href: '#trust', label: c.appbar.anchors.trust },
];
---

<header class="appbar" id="appbar">
  <div class="appbar__inner site-col">
    <a class="appbar__brand t-title-medium" href={lang === 'zh' ? '/' : '/en/'}>
      <!-- 品牌标内联(与 /favicon.svg 同源几何):避免位形随主题反相,深浅底都稳 -->
      <svg width="24" height="24" viewBox="0 0 120 120" aria-hidden="true" focusable="false">
        <defs>
          <linearGradient id="brand-lg" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#D8D3FF"/>
            <stop offset="1" stop-color="#9C87FE"/>
          </linearGradient>
        </defs>
        <rect x="4" y="4" width="112" height="112" rx="26" fill="url(#brand-lg)"/>
        <path d="M29.9 35.1 L54.1 25.4 L106.8 25.4 L106.8 103.5 L29.9 103.5 Z" fill="#fff"/>
        <rect x="43.9" y="46.3" width="20.6" height="16.1" rx="5" fill="#D3CDFF"/>
        <rect x="71" y="46.3" width="20.7" height="16.1" rx="5" fill="#D3CDFF"/>
        <rect x="43.9" y="67.6" width="20.6" height="15.1" rx="5" fill="#D3CDFF"/>
        <rect x="71" y="67.6" width="20.7" height="15.1" rx="5" fill="#947FFF"/>
      </svg>
      Sleepy
    </a>
    <nav class="appbar__anchors" aria-label={c.appbar.navLabel}>
      {
        anchors.map((a) => (
          <a class="appbar__anchor" href={a.href}>{a.label}</a>
        ))
      }
    </nav>
    <nav class="appbar__actions" aria-label={lang === 'zh' ? '页面操作' : 'Page actions'}>
      <a class="site-button site-button--filled appbar__cta t-label-large" href="https://github.com/lingion/sleepy/releases/latest" data-appbar-cta="show">{c.appbar.ctaDownload}</a>
      <a class="site-chip appbar__lang t-label-large" href={other}>{otherLabel}</a>
      <button
        class="appbar__theme"
        type="button"
        title={lang === 'zh' ? '晚课专用。' : 'For evening classes.'}
        aria-label={lang === 'zh' ? '切换深浅色主题(晚课专用。)' : 'Toggle theme (for evening classes.)'}
        data-icon-theme
      >
        <svg class="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17a5 5 0 1 0 0-10 5 5 0 0 0 0 10Zm0-15a1 1 0 0 1 1 1v2a1 1 0 1 1-2 0V3a1 1 0 0 1 1-1Zm0 17a1 1 0 0 1 1 1v2a1 1 0 1 1-2 0v-2a1 1 0 0 1 1-1ZM3.5 5.1A1 1 0 0 1 4.9 3.5l1.4 1.5A1 1 0 1 1 4.9 6.5L3.5 5.1Zm15.2 13.9a1 1 0 0 1 1.4-1.4l1.4 1.4a1 1 0 0 1-1.4 1.5l-1.4-1.5ZM3 12a1 1 0 0 1-1 1H.9a1 1 0 1 1 0-2H2a1 1 0 0 1 1 1Zm19-1a1 1 0 0 1 1 1v.1a1 1 0 1 1-2 0V12a1 1 0 0 1 1-1ZM4.9 19.1a1 1 0 0 1-1.4-1.5L4.9 16a1 1 0 0 1 1.5 1.5l-1.5 1.5ZM19.1 4.9a1 1 0 0 1 1.4 0v.1l-1.4 1.4a1 1 0 0 1-1.5-1.4L19.1 5Z"/></svg>
        <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.3 4.9a.4.4 0 0 0-.5-.5A8.8 8.8 0 1 0 19.6 19a.4.4 0 0 0 .1-.5A10.4 10.4 0 0 1 12.3 4.9Z"/></svg>
      </button>
    </nav>
  </div>
</header>

<style>
  .appbar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--md-sys-color-surface);
    transition: background-color var(--md-sys-motion-duration-short3) var(--md-sys-motion-easing-emphasized);
    /* M3 tonal 滚动态无阴影(投影 = M2 遗留,已纠);边界感由色阶承担 */
  }
  .appbar[data-scrolled='true'] {
    background: var(--md-sys-color-surface-container);
  }
  .appbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: calc(var(--site-unit) * 4);
    block-size: 64px;
  }
  .appbar__brand {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--site-unit) * 2);
    color: var(--md-sys-color-on-surface);
    text-decoration: none;
    flex-shrink: 0;
  }
  /* 锚点组(spec §4:Text 档文字链;≤840px 隐藏) */
  .appbar__anchors {
    display: flex;
    align-items: center;
    gap: calc(var(--site-unit) * 5);
    margin-inline-start: auto;
  }
  .appbar__anchor {
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-on-surface-variant);
    text-decoration: none;
    padding-block: calc(var(--site-unit) * 2);
    transition: color var(--md-sys-motion-duration-short3) var(--md-sys-motion-easing-emphasized);
  }
  @media (hover: hover) and (pointer: fine) {
    .appbar__anchor:hover {
      color: var(--md-sys-color-on-surface);
    }
  }
  .appbar__actions {
    display: flex;
    align-items: center;
    gap: calc(var(--site-unit) * 2);
    flex-shrink: 0;
  }
  .appbar__cta {
    /* Filled S 紧凑档(spec §4):高度压至 36,字号 label-large */
    padding: 6px 16px;
    text-decoration: none;
    /* 互隐过渡(T6):visibility 两态 + opacity 150ms(reduce 档 token 归零自动瞬切);
       禁 display:none —— 锚点/操作组横向布局会跳动 */
    transition:
      opacity var(--md-sys-motion-duration-short3) var(--md-sys-motion-easing-emphasized),
      visibility var(--md-sys-motion-duration-short3) var(--md-sys-motion-easing-emphasized);
  }
  /* hero 在视口内 → 钮隐(spec §11-6 任意视口至多一枚 Filled);缺省 show 可见 */
  .appbar__cta[data-appbar-cta='hide'] {
    opacity: 0;
    visibility: hidden;
  }
  .appbar__lang {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
  }
  .appbar__theme {
    inline-size: 40px;
    block-size: 40px;
    border-radius: var(--md-sys-shape-corner-full);
    border: none;
    background: transparent;
    color: var(--md-sys-color-on-surface-variant);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .appbar__theme:hover {
    background: color-mix(in srgb, var(--md-sys-color-on-surface) 8%, transparent);
  }
  .icon-moon { display: none; }
  :global([data-theme='dark']) .appbar .icon-sun { display: none; }
  :global([data-theme='dark']) .appbar .icon-moon { display: block; }
  @media (max-width: 840px) {
    .appbar__anchors { display: none; }
  }
</style>

<script>
  // tonal 滚动态(spec §2.2:永远置顶;滚动后 surface→surfaceContainer)
  const bar = document.getElementById('appbar');
  if (bar) {
    const mark = () => bar.setAttribute('data-scrolled', String(window.scrollY > 8));
    addEventListener('scroll', mark, { passive: true });
    mark();
  }
  document.querySelector('[data-icon-theme]')?.addEventListener('click', () => window.siteToggleTheme?.());
  // CTA 互隐(T6,spec §11-6):hero 在视口 → 钮 hide;离开 → show。
  // #hero 缺失(无 hero 页/构建异动)或旧内核无 IO → 保持缺省 show,不崩。
  const cta = document.querySelector<HTMLElement>('[data-appbar-cta]');
  const hero = document.getElementById('hero');
  if (cta && hero && 'IntersectionObserver' in window) {
    new IntersectionObserver(([e]) => {
      cta.dataset.appbarCta = e.isIntersecting ? 'hide' : 'show';
    }).observe(hero);
  }
</script>
