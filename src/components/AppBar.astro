---
// v5 AppBar(spec §2.1/§4):三段式 = 品牌标 / 4 枚导航文字链(Text 档,≤840px 隐藏)/ [下载]Filled S + 语言 + 主题
// 滚动态 surface→surface-container tonal 升起(仅 background-color 150ms,无投影);高 64px
// 互隐 IO(T6,spec §11-6):hero 在视口 → appbar CTA hide;离开 → show。缺省态 = hasHero ? show : hide
// —— 工具页(无 hero)JS-off 即恒隐终态,消除「屏上恒见两枚 Filled」(spec §2.4 CTA 纪律)。
// 锚点 href 不变量(spec §2.1):恒为绝对路径形式——锚点项 = 同语言主页锚点(/#views、/#reminders;
// en 页 /en/#*);页面项 = /schools/、/faq/(en 页带 /en/ 前缀)。任意页面点击均回主页锚点。
// label 走 appbar.anchors 键树(zh/en 同形,禁 ternary 硬编码);「学校名录/常见问答」四字形态防 EN 泄漏闸(§15)。
import { zh } from '../i18n/zh';
import type { SiteCopy } from '../i18n/zh';

interface Props {
  lang: 'zh' | 'en';
  copy?: SiteCopy;
  /** 两主页显式 true;缺省 false(工具页)→ CTA 缺省 hide + IO 不启用 */
  hasHero?: boolean;
  /** 本页双语对侧路径(Base 透传):语言链读它,单页硬编码假设废弃(终审 I4) */
  mirror?: string;
}
const { lang, hasHero = false, mirror = lang === 'zh' ? '/en/' : '/' } = Astro.props;
const c = Astro.props.copy ?? zh;
const home = lang === 'zh' ? '/' : '/en/';
const otherLabel = lang === 'zh' ? 'EN' : '中文';
const anchors = [
  { href: `${home}#views`, label: c.appbar.anchors.views },
  { href: `${home}schools/`, label: c.appbar.anchors.schools },
  { href: `${home}faq/`, label: c.appbar.anchors.faq },
  { href: `${home}#reminders`, label: c.appbar.anchors.reminders },
];
const dlHref = `${home}download/`;
---

<header class="appbar" id="appbar">
  <div class="appbar__inner site-col">
    <a class="appbar__brand t-title-medium" href={lang === 'zh' ? '/' : '/en/'}>
      <!-- 品牌标 = /favicon.svg 胶囊 logo 忠实转写(几何/色值逐字照抄源文件,禁反相禁改底;白底方块深浅主题均稳) -->
      <svg width="24" height="24" viewBox="0 0 512 512" aria-hidden="true" focusable="false">
        <rect width="512" height="512" rx="115" fill="#FFFFFF"/>
        <rect x="63" y="117" width="36" height="118" rx="18" fill="#9176DF"/>
        <rect x="63" y="335" width="36" height="60" rx="18" fill="#9176DF"/>
        <rect x="121" y="82" width="36" height="198" rx="18" fill="#9176DF"/>
        <rect x="121" y="346" width="36" height="72" rx="18" fill="#9176DF"/>
        <rect x="180" y="59" width="35" height="95" rx="17" fill="#9176DF"/>
        <rect x="180" y="220" width="35" height="118" rx="17" fill="#9176DF"/>
        <rect x="180" y="404" width="35" height="49" rx="17" fill="#9176DF"/>
        <rect x="238" y="48" width="36" height="95" rx="18" fill="#9176DF"/>
        <rect x="238" y="208" width="36" height="96" rx="18" fill="#9176DF"/>
        <rect x="238" y="369" width="36" height="95" rx="18" fill="#9176DF"/>
        <rect x="297" y="59" width="35" height="49" rx="17" fill="#9176DF"/>
        <rect x="297" y="174" width="35" height="118" rx="17" fill="#9176DF"/>
        <rect x="297" y="358" width="35" height="95" rx="17" fill="#9176DF"/>
        <rect x="355" y="94" width="35" height="72" rx="17" fill="#C2C4D0"/>
        <rect x="414" y="117" width="35" height="60" rx="17" fill="#C2C4D0"/>
        <rect x="414" y="277" width="35" height="118" rx="17" fill="#C2C4D0"/>
        <rect x="355" y="232" width="35" height="197" rx="17" fill="#C2C4D0"/>
      </svg>
      Sleepy
    </a>
    <nav class="appbar__anchors" aria-label={c.appbar.navLabel}>
      {
        anchors.map((a) => (
          <a class="appbar__anchor" href={a.href}>{a.label}</a>
        ))
      }
    </nav>
    <nav class="appbar__actions" aria-label={lang === 'zh' ? '页面操作' : 'Page actions'}>
      <a class="site-button site-button--filled appbar__cta t-label-large" href={dlHref} data-appbar-cta={hasHero ? 'show' : 'hide'}>{c.appbar.ctaDownload}</a>
      <a class="site-chip appbar__lang t-label-large" href={mirror}>{otherLabel}</a>
      <button
        class="appbar__theme"
        type="button"
        title={lang === 'zh' ? '晚课专用。' : 'For evening classes.'}
        aria-label={lang === 'zh' ? '切换深浅色主题(晚课专用。)' : 'Toggle theme (for evening classes.)'}
        data-icon-theme
      >
        <svg class="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17a5 5 0 1 0 0-10 5 5 0 0 0 0 10Zm0-15a1 1 0 0 1 1 1v2a1 1 0 1 1-2 0V3a1 1 0 0 1 1-1Zm0 17a1 1 0 0 1 1 1v2a1 1 0 1 1-2 0v-2a1 1 0 0 1 1-1ZM3.5 5.1A1 1 0 0 1 4.9 3.5l1.4 1.5A1 1 0 1 1 4.9 6.5L3.5 5.1Zm15.2 13.9a1 1 0 0 1 1.4-1.4l1.4 1.4a1 1 0 0 1-1.4 1.5l-1.4-1.5ZM3 12a1 1 0 0 1-1 1H.9a1 1 0 1 1 0-2H2a1 1 0 0 1 1 1Zm19-1a1 1 0 0 1 1 1v.1a1 1 0 1 1-2 0V12a1 1 0 0 1 1-1ZM4.9 19.1a1 1 0 0 1-1.4-1.5L4.9 16a1 1 0 0 1 1.5 1.5l-1.5 1.5ZM19.1 4.9a1 1 0 0 1 1.4 0v.1l-1.4 1.4a1 1 0 0 1-1.5-1.4L19.1 5Z"/></svg>
        <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.3 4.9a.4.4 0 0 0-.5-.5A8.8 8.8 0 1 0 19.6 19a.4.4 0 0 0 .1-.5A10.4 10.4 0 0 1 12.3 4.9Z"/></svg>
      </button>
      <!-- 汉堡菜单(2026-10-25 用户报:≤840px 锚点组 display:none 后手机无页间导航):
           轻量 disclosure 模式,桌面隐藏/移动显示;面板复用 anchors 同源 href 不变量 -->
      <button
        class="appbar__menu"
        type="button"
        aria-expanded="false"
        aria-controls="appbar-menu"
        aria-label={lang === 'zh' ? '打开导航菜单' : 'Open navigation menu'}
        data-appbar-menu
        data-label-open={lang === 'zh' ? '打开导航菜单' : 'Open navigation menu'}
        data-label-close={lang === 'zh' ? '关闭导航菜单' : 'Close navigation menu'}
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </nav>
  </div>
  <nav class="appbar__menu-panel" id="appbar-menu" aria-label={c.appbar.navLabel} hidden>
    {
      anchors.map((a) => (
        <a class="appbar__menu-link t-title-small" href={a.href}>{a.label}</a>
      ))
    }
    <a class="appbar__menu-link appbar__menu-dl t-title-small" href={dlHref}>{c.appbar.ctaDownload}</a>
  </nav>
</header>

<style>
  .appbar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--md-sys-color-surface);
    transition: background-color var(--md-sys-motion-duration-short3) var(--md-sys-motion-easing-emphasized);
    /* M3 tonal 滚动态无阴影(投影 = M2 遗留,已纠);边界感由色阶承担 */
  }
  .appbar[data-scrolled='true'] {
    background: var(--md-sys-color-surface-container);
  }
  .appbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: calc(var(--site-unit) * 4);
    block-size: 64px;
  }
  .appbar__brand {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--site-unit) * 2);
    color: var(--md-sys-color-on-surface);
    text-decoration: none;
    flex-shrink: 0;
  }
  /* 锚点组(spec §4:Text 档文字链;≤840px 隐藏) */
  .appbar__anchors {
    display: flex;
    align-items: center;
    gap: calc(var(--site-unit) * 5);
    margin-inline-start: auto;
  }
  .appbar__anchor {
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-on-surface-variant);
    text-decoration: none;
    padding-block: calc(var(--site-unit) * 2);
    transition: color var(--md-sys-motion-duration-short3) var(--md-sys-motion-easing-emphasized);
  }
  @media (hover: hover) and (pointer: fine) {
    .appbar__anchor:hover {
      color: var(--md-sys-color-on-surface);
    }
  }
  .appbar__actions {
    display: flex;
    align-items: center;
    gap: calc(var(--site-unit) * 2);
    flex-shrink: 0;
  }
  .appbar__cta {
    /* Filled S 紧凑档(spec §4):高度压至 36,字号 label-large */
    padding: 6px 16px;
    text-decoration: none;
    /* 互隐过渡(T6):visibility 两态 + opacity 150ms(reduce 档 token 归零自动瞬切);
       禁 display:none —— 锚点/操作组横向布局会跳动 */
    transition:
      opacity var(--md-sys-motion-duration-short3) var(--md-sys-motion-easing-emphasized),
      visibility var(--md-sys-motion-duration-short3) var(--md-sys-motion-easing-emphasized);
  }
  /* hero 在视口内 → 钮隐(spec §11-6 任意视口至多一枚 Filled);缺省态 = hasHero ? show : hide */
  .appbar__cta[data-appbar-cta='hide'] {
    opacity: 0;
    visibility: hidden;
  }
  .appbar__lang {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
  }
  .appbar__theme {
    inline-size: 40px;
    block-size: 40px;
    border-radius: var(--md-sys-shape-corner-full);
    border: none;
    background: transparent;
    color: var(--md-sys-color-on-surface-variant);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  /* hover 位移闸(v4 §12):粘滞 hover 态只在真悬停设备生效;触屏按压走 :active(全局 state layer) */
  @media (hover: hover) and (pointer: fine) {
    .appbar__theme:hover {
      background: color-mix(in srgb, var(--md-sys-color-on-surface) 8%, transparent);
    }
  }
  .icon-moon { display: none; }
  :global([data-theme='dark']) .appbar .icon-sun { display: none; }
  :global([data-theme='dark']) .appbar .icon-moon { display: block; }
  /* 汉堡钮:桌面恒隐(锚点组在场),≤840px 接管锚点组的导航职责 */
  .appbar__menu {
    display: none;
    inline-size: 40px;
    block-size: 40px;
    border-radius: var(--md-sys-shape-corner-full);
    border: none;
    background: transparent;
    color: var(--md-sys-color-on-surface-variant);
    cursor: pointer;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  @media (hover: hover) and (pointer: fine) {
    .appbar__menu:hover {
      background: color-mix(in srgb, var(--md-sys-color-on-surface) 8%, transparent);
    }
  }
  .appbar__menu-panel {
    display: grid;
    border-block-start: 1px solid var(--md-sys-color-outline-variant);
    background: var(--md-sys-color-surface-container);
    padding-block: calc(var(--site-unit) * 2);
  }
  .appbar__menu-panel[hidden] { display: none; }
  .appbar__menu-link {
    color: var(--md-sys-color-on-surface);
    text-decoration: none;
    padding: calc(var(--site-unit) * 3) calc(var(--site-unit) * 6);
    min-block-size: 44px; /* 触屏目标 ≥44(站点纪律) */
    display: flex;
    align-items: center;
  }
  .appbar__menu-dl {
    color: var(--md-sys-color-primary);
  }
  @media (max-width: 840px) {
    .appbar__anchors { display: none; }
    .appbar__menu { display: inline-flex; }
  }
</style>

<script>
  // tonal 滚动态(spec §2.2:永远置顶;滚动后 surface→surfaceContainer)
  const bar = document.getElementById('appbar');
  if (bar) {
    const mark = () => bar.setAttribute('data-scrolled', String(window.scrollY > 8));
    addEventListener('scroll', mark, { passive: true });
    mark();
  }
  document.querySelector('[data-icon-theme]')?.addEventListener('click', () => window.siteToggleTheme?.());
  // 汉堡 disclosure:钮只管 aria-expanded ⇄ 面板 hidden;链接点击/Esc/升档回桌面 均收合
  const menuBtn = document.querySelector<HTMLButtonElement>('[data-appbar-menu]');
  const menuPanel = document.getElementById('appbar-menu');
  if (menuBtn && menuPanel) {
    const setOpen = (open: boolean) => {
      menuPanel.hidden = !open;
      menuBtn.setAttribute('aria-expanded', String(open));
      menuBtn.setAttribute('aria-label', open ? menuBtn.dataset.labelClose! : menuBtn.dataset.labelOpen!);
    };
    menuBtn.addEventListener('click', () => setOpen(menuPanel.hidden));
    menuPanel.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menuPanel.hidden) {
        setOpen(false);
        menuBtn.focus();
      }
    });
    matchMedia('(min-width: 841px)').addEventListener('change', (ev) => {
      if (ev.matches) setOpen(false);
    });
  }
  // CTA 互隐(T6,spec §11-6):hero 在视口 → 钮 hide;离开 → show。
  // 非主页 markup 缺省即 hide 终态,无 #hero 时 IO 不启用(spec §2.4 CTA 纪律);
  // #hero 缺失(无 hero 页/构建异动)或旧内核无 IO → 保持缺省态,不崩。
  const cta = document.querySelector<HTMLElement>('[data-appbar-cta]');
  const hero = document.getElementById('hero');
  if (cta && hero && 'IntersectionObserver' in window) {
    new IntersectionObserver(([e]) => {
      cta.dataset.appbarCta = e.isIntersecting ? 'hide' : 'show';
    }).observe(hero);
  }
</script>
