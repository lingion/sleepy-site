---
// 主题感知截图 —— 浅色浏览器显示浅色截图,深色浏览器显示深色截图。
// data-theme 由 Base.astro 首帧前脚本设定(FOUC 守卫),这里纯 CSS 切换,零 JS、零闪变。
// 两张图都是真机截图,深色那张对读屏器隐藏(alt=""),避免同一内容重复朗读。
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  light: ImageMetadata;
  dark: ImageMetadata;
  /** 朗读文本(浅色图承载;深色图 aria-hidden) */
  alt: string;
  widths?: number[];
  sizes?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
  /**
   * LCP 前景标记(T3):true → light 版 fetchpriority="high" + loading="eager",
   * 隐藏的 dark 版反向降载 fetchpriority="low" + loading="lazy"(防浏览器预取占带宽)。
   * 缺省 false = 两版沿用 loading,行为不变。全站只允许一处 true(hero 前景)。
   */
  priority?: boolean;
  /**
   * 变体锁定(通用能力,预留):强制带内截图固定取某一主题版,不随主题翻转。
   * 2026-10-25 巡检批:M6 画廊已改随主题翻转,当前无消费方;两版仍渲染,仅 CSS 层定显示。
   */
  forceVariant?: 'light' | 'dark';
}
const {
  light,
  dark,
  alt,
  widths = [420, 840],
  sizes,
  loading = 'lazy',
  class: className,
  priority = false,
  forceVariant,
} = Astro.props;
const forceClass = forceVariant ? `shot--force-${forceVariant}` : undefined;
---

<span class:list={['shot', className, forceClass]}>
  <Image
    class="shot__i shot__light"
    src={light}
    widths={widths}
    sizes={sizes}
    alt={alt}
    width={light.width}
    height={light.height}
    loading={priority ? 'eager' : loading}
    fetchpriority={priority ? 'high' : undefined}
    decoding="async"
  />
  <Image
    class="shot__i shot__dark"
    src={dark}
    widths={widths}
    sizes={sizes}
    alt=""
    aria-hidden="true"
    width={dark.width}
    height={dark.height}
    loading={priority ? 'lazy' : loading}
    fetchpriority={priority ? 'low' : undefined}
    decoding="async"
  />
</span>

<style>
  /* contents:让两张图在布局上等同于直接子节点,消费方的 `容器 img` 选择器照常命中 */
  .shot {
    display: contents;
  }
  /* 块级化责任归组件自持(2026-10-25 hero 双显事故:消费方带 id 的 img{display:block}
     (1,1,1) 压过本组件主题规则 (0,2,0)/(0,3,0) → 双图同显。img 显隐唯一源在此,
     消费方禁再声明 display;light 显式块级顺带消 inline 基线缝隙) */
  .shot__light {
    display: block;
  }
  .shot__dark {
    display: none;
  }
  :global([data-theme='dark']) .shot__light {
    display: none;
  }
  :global([data-theme='dark']) .shot__dark {
    display: block;
  }
  /* 强制变体(通用能力,当前无消费方):命中 forceClass 时该版恒显/恒藏,不随主题翻转。
     规则置于主题翻转之后:同 specificity 源码序胜出,更高阶选择器直接压过 */
  .shot--force-light .shot__dark,
  :global([data-theme='dark']) .shot--force-light .shot__dark {
    display: none;
  }
  .shot--force-light .shot__light,
  :global([data-theme='dark']) .shot--force-light .shot__light {
    display: block;
  }
</style>
