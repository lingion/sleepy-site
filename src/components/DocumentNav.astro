---
interface Props { label: string; links: { href: string; label: string }[] }
const { label, links } = Astro.props;
const listId = `contents-${links[0]?.href.slice(1) ?? 'page'}`;
---
<nav class="document-nav" aria-label={label} data-document-nav data-role="toc">
  <p class="document-nav__label t-label-large">{label}</p>
  <button class="document-nav__toggle site-button site-button--tonal" type="button" aria-expanded="false" aria-controls={listId} hidden>
    {label}<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
  </button>
  <ul id={listId}>{links.map((link, index) => <li><a href={link.href} data-toc-link aria-current={index === 0 ? "location" : undefined}>{link.label}</a></li>)}</ul>
</nav>
<script>
  for (const nav of document.querySelectorAll<HTMLElement>('[data-document-nav]')) {
    const toggle = nav.querySelector<HTMLButtonElement>('button')!;
    const links = [...nav.querySelectorAll<HTMLAnchorElement>('a')];
    toggle.hidden = false;
    nav.dataset.enhanced = '';
    toggle.addEventListener('click', () => toggle.setAttribute('aria-expanded', String(toggle.getAttribute('aria-expanded') !== 'true')));
    for (const link of links) link.addEventListener('click', () => {
      const target = document.getElementById(link.hash.slice(1));
      if (!target) return;
      target.tabIndex = -1;
      target.focus({ preventScroll: true });
      toggle.setAttribute('aria-expanded', 'false');
    });
    const sections = links.map(link => document.getElementById(link.hash.slice(1))).filter((el): el is HTMLElement => !!el);
    if (!sections.length || !('IntersectionObserver' in window)) continue;
    const activate = (id: string) => {
      for (const link of links) {
        if (link.hash === `#${id}`) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      }
    };
    const current = location.hash.slice(1);
    activate(sections.some(section => section.id === current) ? current : sections[0].id);
    const observer = new IntersectionObserver(entries => {
      for (const entry of entries) if (entry.isIntersecting) activate(entry.target.id);
    }, { rootMargin: '-100px 0px -55% 0px' });
    for (const section of sections) observer.observe(section);
  }
</script>
