---
// M8 下载出口段(v5 瘦身,plan Task 7 / spec §2.2):主页单一转化出口
// tonal 带底不变(全站唯一彩色大面);主钮 = Elevated 档直链 release.json universal APK(§11-6:Filled=2 不破)。
// 原 ABI 行列表、sha 链、商店占位、体验链全部移出主页 → /download/ 面板(Task 5 已落地,行样式 blend 随 I11 定死迁 DownloadPanel)。
// 次行 Text 链「其他架构与校验 →」指 /download/(§10 行 5 新去向);版本行 tag·日期 tnum(download.versionLine 函数形态)。
import Shot from '../Shot.astro';
import gridLight from '../../assets/screenshots/02-grid-light.png';
import gridDark from '../../assets/screenshots/02-grid-dark.png';
import release from '../../data/release.json';
import { zh } from '../../i18n/zh';
import type { SiteCopy } from '../../i18n/zh';

interface Props {
  copy?: SiteCopy;
  /** 显示语言:决定「其他架构与校验」次链前缀(zh=/download/,en=/en/download/) */
  lang?: 'zh' | 'en';
}
const c = Astro.props.copy ?? zh;
const lang = Astro.props.lang ?? 'zh';
const t = c.download;
const dp = c.downloadPage;
const moreHref = lang === 'en' ? '/en/download/' : '/download/';
const date = release.date.slice(0, 10);
const universal = release.assets.find((a) => a.name.includes('universal'))!;
---

<section class="site-section download--tonal" id="download" data-prototype="tonal-band" aria-labelledby="download-title">
  <div class="site-col download__grid">
    <div class="download__main">
      <h2 class="t-headline-large" id="download-title">{t.heading}</h2>
      <p class="t-body-medium download__version tnum">{t.versionLine(release.tag, date)}</p>
      <p class="download__cta">
        <a class="site-button site-button--elevated download__cta-xl" href={universal.url} download rel="download" aria-label={t.downloadAria('universal', `${(universal.size / 1024 / 1024).toFixed(1)} MB`)}>{t.cta}</a>
      </p>
      <p class="t-body-small download__note">{t.universalNote}</p>
      <p class="t-body-small download__more">
        <a class="site-button site-button--text" href={moreHref}>{dp.otherArchLink}</a>
      </p>
    </div>
    <div class="download__media reveal" style="--reveal-i: 0;">
      <div class="download__frame">
        <Shot
          light={gridLight}
          dark={gridDark}
          widths={[360, 720]}
          sizes="(max-width: 840px) 86vw, 400px"
          alt={t.deviceCaption}
          loading="lazy"
        />
      </div>
    </div>
  </div>
</section>

<style>
  /* tonal 转化带:primary-container 平涂(全站唯一彩色大面,面积仍守 §5.3「彩色<10%」——
     带是容器档不是主色档);对比一律 on-primary-container 配对(§11-10 配对红线) */
  .download--tonal {
    background: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
    /* dark 节奏补丁(§17.1):发丝顶边拉相邻档步长 */
    border-block-start: 1px solid var(--md-sys-color-outline-variant);
  }
  .download--tonal h2 {
    color: var(--md-sys-color-on-primary-container);
  }
  .download__grid {
    display: grid;
    grid-template-columns: 55fr 45fr;
    gap: calc(var(--site-unit) * 10);
    align-items: center;
  }
  .download__main {
    display: grid;
    gap: 0;
  }
  .download__version {
    color: var(--md-sys-color-on-primary-container);
    margin-block: calc(var(--site-unit) * 3) calc(var(--site-unit) * 4);
    font-variant-numeric: lining-nums tabular-nums;
  }
  /* 主钮 = Elevated 档(§11-6:彩色容器上禁 tonal 叠 tonal → surface 底 + elevation-1) */
  .download__cta {
    margin-block-end: calc(var(--site-unit) * 4);
  }
  .download__cta-xl {
    font-size: 16px;
    padding: 14px 32px;
    text-decoration: none;
  }
  .download__note {
    color: color-mix(in srgb, var(--md-sys-color-on-primary-container) 82%, var(--md-sys-color-primary-container));
  }
  .download__more {
    margin-block-start: calc(var(--site-unit) * 3);
  }
  .download__more a {
    color: var(--md-sys-color-on-primary-container);
  }
  /* Shot img 不带本组件 scope → :global */
  .download__media {
    margin: 0;
  }
  .download__frame {
    border-radius: var(--md-sys-shape-corner-xl);
    background: var(--md-sys-color-surface);
    border: 1px solid var(--md-sys-color-outline-variant);
    padding: calc(var(--site-unit) * 3);
  }
  :global(#download .download__frame img) {
    border-radius: calc(var(--site-unit) * 3);
    inline-size: 100%;
    block-size: auto;
    object-fit: contain; /* C3/§5.4:完整显示,禁 cover */
  }
  @media (max-width: 840px) {
    /* §9 M8 手机:钮 edge-to-edge,截图置底(单列堆叠,DOM 文上图下) */
    .download__grid {
      grid-template-columns: 1fr;
    }
    .download__cta-xl {
      inline-size: 100%;
      justify-content: center;
    }
  }
</style>
