---
// ⑤ 下载 — spec §3⑤:latest 直链 + 四 ABI 行 + sha256 外链 + blob#2
// 2026-10-20 用户修订:裸文本链 → 下载行(架构名 + 人话注 + 大小 + 下载图标);
//   行注(近几年的手机/模拟器…)替代「通吃」黑话;universal 行打「推荐」。
// §4.2:tag/date 烘自 release.json(构建 owner = Actions);商店灰态 = 预留占位(§0 非目标)
import Blob from '../Blob.astro';
import { Image } from 'astro:assets';
import grid from '../../assets/screenshots/02-schedule-grid.png';
import release from '../../data/release.json';
import { zh } from '../../i18n/zh';
import type { SiteCopy } from '../../i18n/zh';
import { onlineTrialUrl } from '../../i18n/ui';

interface Props {
  copy?: SiteCopy;
}
const t = (Astro.props.copy ?? zh).download;
const abiOf = (name: string) => name.replace(/^app-|-release\.apk$/g, '');
const mb = (bytes: number) => `${(bytes / 1024 / 1024).toFixed(1)} MB`;
const date = release.date.slice(0, 10);
const notes = t.abiNotes as Record<string, string>;
---

<section class="site-section download" id="download" aria-labelledby="download-title">
  <Blob variant={1} />
  <div class="site-col download__grid">
    <div>
      <h2 class="t-headline-large" id="download-title">{t.heading}</h2>
      <p class="t-body-medium download__version">
        <a href="https://github.com/lingion/sleepy/releases/latest">GitHub Releases</a> ·
        {t.versionLine(release.tag, date)} · {t.minSdk}
      </p>
      <ul class="download__list">
        {
          release.assets.map((a) => {
            const abi = abiOf(a.name);
            const size = mb(a.size);
            const isRec = abi === 'universal';
            return (
              <li>
                <a class="download__row" data-rec={isRec || undefined} href={a.url} download rel="download" aria-label={t.downloadAria(abi, size)}>
                  <span class="download__row-main">
                    <span class="download__row-name">
                      {abi}
                      {isRec && <span class="download__row-badge">{t.recommended}</span>}
                    </span>
                    <span class="download__row-note">{notes[abi]}</span>
                  </span>
                  <span class="download__row-side">
                    <span class="download__row-size">{size}</span>
                    <svg class="download__row-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
                      <path d="M11 4h2v9.15l3.6-3.6 1.4 1.45-5.5 5.5-5.5-5.5 1.4-1.45 3.6 3.6z" fill="currentColor" /><path d="M4 18h16v2H4z" fill="currentColor" />
                    </svg>
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>
      <p class="t-body-small download__note">{t.universalNote}</p>
      <p class="t-body-small download__sha">
        <a href={release.sha256sumsUrl}>{t.shaLink}</a>
      </p>
      <div class="download__stores">
        <span class="store-badge" data-store-disabled aria-disabled="true" title={t.storeReserved}>Google Play</span>
        <span class="store-badge" data-store-disabled aria-disabled="true" title={t.storeReserved}>{t.storeBadgeCn}</span>
      </div>
      <p class="t-body-small download__trial"><a href={onlineTrialUrl}>{t.trial}</a></p>
    </div>
    <div class="download__media">
      <Image
        src={grid}
        widths={[360, 720]}
        sizes="(max-width: 840px) 88vw, 380px"
        alt={t.deviceCaption}
        width={grid.width}
        height={grid.height}
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
</section>

<style>
  .download {
    position: relative;
    overflow: hidden;
  }
  .download__grid {
    display: grid;
    grid-template-columns: 55fr 45fr;
    gap: calc(var(--site-unit) * 10);
    align-items: center;
  }
  .download__version {
    color: var(--md-sys-color-on-surface-variant);
    margin-block: calc(var(--site-unit) * 3) calc(var(--site-unit) * 6);
  }
  .download__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: calc(var(--site-unit) * 2);
    max-inline-size: 440px;
  }
  .download__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: calc(var(--site-unit) * 4);
    padding: calc(var(--site-unit) * 3.5) calc(var(--site-unit) * 5);
    border-radius: var(--md-sys-shape-corner-medium);
    background: var(--md-sys-color-surface-container);
    color: var(--md-sys-color-on-surface);
    text-decoration: none;
    transition:
      background-color var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-emphasized),
      box-shadow var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-emphasized);
  }
  .download__row:hover {
    background: var(--md-sys-color-surface-container-high);
    box-shadow: 0 1px 3px rgb(0 0 0 / 8%);
  }
  .download__row:focus-visible {
    outline: 2px solid var(--md-sys-color-primary);
    outline-offset: 2px;
  }
  .download__row-main {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .download__row-name {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--site-unit) * 2);
    font: var(--md-sys-typescale-title-small);
  }
  .download__row-badge {
    font: var(--md-sys-typescale-label-small);
    padding: 2px 8px;
    border-radius: var(--md-sys-shape-corner-full);
    background: var(--md-sys-color-primary);
    color: var(--md-sys-color-on-primary);
  }
  .download__row[data-rec] {
    background: var(--md-sys-color-secondary-container);
    color: var(--md-sys-color-on-secondary-container);
  }
  .download__row[data-rec]:hover {
    background: color-mix(in srgb, var(--md-sys-color-secondary-container) 85%, var(--md-sys-color-on-secondary-container));
  }
  .download__row[data-rec] .download__row-note,
  .download__row[data-rec] .download__row-size {
    color: inherit;
    opacity: 0.72;
  }
  .download__row-note {
    font: var(--md-sys-typescale-body-small);
    color: var(--md-sys-color-on-surface-variant);
  }
  .download__row-side {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--site-unit) * 4);
    flex-shrink: 0;
  }
  .download__row-size {
    font: var(--md-sys-typescale-body-small);
    color: var(--md-sys-color-on-surface-variant);
    font-variant-numeric: tabular-nums;
  }
  .download__row-icon {
    display: block;
  }
  .download__note {
    margin-block-start: calc(var(--site-unit) * 3);
    color: var(--md-sys-color-on-surface-variant);
  }
  .download__sha {
    margin-block-start: calc(var(--site-unit) * 2);
  }
  .download__stores {
    display: flex;
    gap: calc(var(--site-unit) * 3);
    margin-block-start: calc(var(--site-unit) * 5);
  }
  .store-badge {
    display: inline-flex;
    align-items: center;
    padding: calc(var(--site-unit) * 2) calc(var(--site-unit) * 4);
    border-radius: var(--md-sys-shape-corner-small);
    background: var(--md-sys-color-surface-container);
    color: var(--md-sys-color-on-surface-variant);
    opacity: 0.45;
    font: var(--md-sys-typescale-label-medium);
  }
  .download__trial {
    margin-block-start: calc(var(--site-unit) * 5);
  }
  .download__media img {
    border-radius: var(--md-sys-shape-corner-xl);
    inline-size: 100%;
    /* 视觉预算 §2.4:裁顶保内容,下载段收进 ~1×100vh */
    max-block-size: 560px;
    object-fit: cover;
    object-position: top;
  }
  @media (max-width: 840px) {
    .download__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
