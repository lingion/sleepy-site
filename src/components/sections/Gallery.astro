---
// M6 截图长廊(v4 spec §4:FULL-BLEED 断章换幕带 · 恒暗 band,§17.1 不随主题翻转)
// 带内 = --site-band-bg/-fg 消费点(T2 预埋,T5 落地);Shot forceVariant='light':深底配浅 UI 恒成立。
// 原型:横向 filmstrip;叠压仅限装饰层(ghost 背景层 ±错位),可点 figure 完整可见(§4 M6/§12);
// 错落 = margin-top 交替 ±16px。收编 weekview 入廊(§8-3),定稿 8 图。
// lightbox 岛 a11y 全项保留(焦点圈定/Esc/方向键/主题感知换图)——那是已验收件,零改动。
import Shot from '../Shot.astro';
import gridL from '../../assets/screenshots/02-grid-light.png';
import gridD from '../../assets/screenshots/02-grid-dark.png';
import weekL from '../../assets/screenshots/01-week-light.png';
import weekD from '../../assets/screenshots/01-week-dark.png';
import todayL from '../../assets/screenshots/03-today-light.png';
import todayD from '../../assets/screenshots/03-today-dark.png';
import manageL from '../../assets/screenshots/04-manage-light.png';
import manageD from '../../assets/screenshots/04-manage-dark.png';
import themeL from '../../assets/screenshots/11-theme-light.png';
import themeD from '../../assets/screenshots/11-theme-dark.png';
import mineL from '../../assets/screenshots/05-mine-light.png';
import mineD from '../../assets/screenshots/05-mine-dark.png';
import importL from '../../assets/screenshots/20-import-light.png';
import importD from '../../assets/screenshots/20-import-dark.png';
import wViewL from '../../assets/screenshots/widget-weekview-light.png';
import wViewD from '../../assets/screenshots/widget-weekview-dark.png';
import { zh } from '../../i18n/zh';
import type { SiteCopy } from '../../i18n/zh';

interface Props {
  copy?: SiteCopy;
}
const t = (Astro.props.copy ?? zh).gallery;
// 廊内 8 图(captions 同序);kind: phone=竖屏 / widget=桌面组件(扁,自然比例)
const shots = [
  { light: gridL, dark: gridD, kind: 'phone' },
  { light: weekL, dark: weekD, kind: 'phone' },
  { light: todayL, dark: todayD, kind: 'phone' },
  { light: manageL, dark: manageD, kind: 'phone' },
  { light: themeL, dark: themeD, kind: 'phone' },
  { light: mineL, dark: mineD, kind: 'phone' },
  { light: importL, dark: importD, kind: 'phone' },
  { light: wViewL, dark: wViewD, kind: 'widget' },
];
---

<section class="site-section band" id="gallery" data-prototype="full-bleed-band" aria-labelledby="gallery-title">
  <div class="site-col">
    <h2 class="t-headline-large band__heading" id="gallery-title">{t.heading}</h2>
    <p class="t-body-medium band__sub">{t.sub}</p>
  </div>
  <div class="gallery__strip" data-reveal-group="m6-strip">
    <div class="gallery__track site-col">
      {
        shots.map((s, i) => (
          <figure class:list={['gallery__figure', s.kind === 'widget' && 'gallery__figure--widget', 'reveal']} data-gallery-figure style={`--reveal-i: ${i};`}>
            <button type="button" class="gallery__open" data-index={i} aria-label={t.captions[i]}>
              <Shot
                light={s.light}
                dark={s.dark}
                widths={[300, 600]}
                sizes="(max-width: 600px) 72vw, 300px"
                alt={t.captions[i]}
                loading="lazy"
                forceVariant="light"
              />
            </button>
            <figcaption class="t-label-small">{t.captions[i]}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>

  <div class="lightbox" data-lightbox role="dialog" aria-modal="true" aria-label={t.heading} hidden>
    <div class="lightbox__scrim" data-lb-scrim></div>
    <div class="lightbox__body">
      <img class="lightbox__img" data-lb-img alt="" />
      <div class="lightbox__bar">
        <button type="button" class="lightbox__nav" data-lb-prev aria-label={t.prev}>←</button>
        <span class="t-label-medium" data-lb-count></span>
        <button type="button" class="lightbox__nav" data-lb-next aria-label={t.next}>→</button>
        <button type="button" class="lightbox__nav" data-lb-close aria-label={t.close}>×</button>
      </div>
    </div>
  </div>
</section>

<style>
  /* 换幕带(class 消费 T2 预埋 --site-band-*;恒暗,明暗主题同值 → §12 带内明暗节奏由色阶跳本身完成)。
     band 发丝顶边 = dark 节奏补丁(§17.1):outline-variant 装饰边,light 下亦存在不违和 */
  .band {
    background: var(--site-band-bg);
    color: var(--site-band-fg);
    border-block-start: 1px solid var(--md-sys-color-outline-variant);
  }
  .band__heading {
    color: var(--site-band-fg);
  }
  .band__sub {
    color: color-mix(in srgb, var(--site-band-fg) 72%, var(--site-band-bg));
    margin-block: calc(var(--site-unit) * 3) calc(var(--site-unit) * 6);
  }
  /* filmstrip:横滚 + snap;轨道 = 内容列宽 1040(§9) */
  .gallery__strip {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    padding-block: calc(var(--site-unit) * 2);
  }
  .gallery__track {
    display: flex;
    gap: calc(var(--site-unit) * 5);
    inline-size: max-content;
    padding-block: calc(var(--site-unit) * 4);
  }
  .gallery__figure {
    margin: 0;
    scroll-snap-align: center;
    /* 错落 = margin-top 交替 ±16px(叠压仅视觉错位,figure 间零遮挡,§4 M6) */
    margin-block-start: 16px;
  }
  .gallery__figure:nth-child(even) {
    margin-block-start: 0;
  }
  .gallery__open {
    display: block;
    inline-size: 300px;
    padding: 0;
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-large);
    background: var(--md-sys-color-surface-container-low);
    cursor: zoom-in;
    overflow: clip;
  }
  /* Shot img 不带本组件 scope → :global */
  :global(#gallery .gallery__open img) {
    inline-size: 100%;
    block-size: auto;
    object-fit: contain; /* 完整可读(C3 精神):廊内缩略不再 cover 裁顶 */
  }
  :global(#gallery .gallery__figure--widget .gallery__open img) {
    aspect-ratio: 825 / 550;
    padding: calc(var(--site-unit) * 3);
    block-size: auto;
  }
  .gallery__figure figcaption {
    margin-block-start: calc(var(--site-unit) * 2);
    color: color-mix(in srgb, var(--site-band-fg) 78%, var(--site-band-bg));
    text-align: center;
  }
  @media (max-width: 840px) {
    .gallery__open {
      inline-size: min(72vw, 300px);
    }
  }

  /* —— lightbox 岛(已验收 a11y 件,本体保留;bar 色随 band 恒暗语义) —— */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
  }
  .lightbox[hidden] { display: none; }
  .lightbox__scrim {
    position: absolute;
    inset: 0;
    background: var(--site-lightbox-scrim);
  }
  .lightbox__body {
    position: relative;
    max-width: min(1040px, 92vw);
    display: grid;
    gap: calc(var(--site-unit) * 3);
    justify-items: center;
  }
  .lightbox__img {
    max-inline-size: 92vw;
    max-block-size: 76vh;
    border-radius: var(--md-sys-shape-corner-large);
    background: var(--md-sys-color-surface);
  }
  .lightbox__bar {
    display: flex;
    align-items: center;
    gap: calc(var(--site-unit) * 3);
    color: #fff;
  }
  .lightbox__nav {
    font: var(--md-sys-typescale-title-large);
    inline-size: 44px;
    block-size: 44px;
    border-radius: var(--md-sys-shape-corner-full);
    border: 1px solid var(--md-sys-color-outline);
    background: var(--md-sys-color-surface);
    color: var(--md-sys-color-on-surface);
    cursor: pointer;
  }
</style>

<script>
  // lightbox 岛(vanilla + Motion One enter/exit 配对 §2.3;焦点圈定/Esc/←→/归还 §3④)
  // 主题感知:每张缩略含浅/深两版,取当前可见版;灯箱开着时切主题 → MutationObserver 换图。
  import { animate } from 'motion/mini';

  const sec = document.getElementById('gallery');
  if (sec) {
    const lb = sec.querySelector<HTMLElement>('[data-lightbox]')!;
    const img = lb.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const count = lb.querySelector<HTMLElement>('[data-lb-count]')!;
    const figs = [...sec.querySelectorAll<HTMLButtonElement>('.gallery__open')];
    const FOCUSABLE = 'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])';
    const RM = matchMedia('(prefers-reduced-motion: reduce)'); // reduced-motion → opacity 单档
    const root = document.documentElement;
    let cur = 0;
    let opener: HTMLElement | null = null;

    const srcOf = (i: number) => {
      // band 内 force-variant light:shot--force-light 恒取 .shot__light(深底配浅 UI,§4 M6)
      const want = sec.classList.contains('band')
        ? 'shot__light'
        : root.getAttribute('data-theme') === 'dark'
          ? 'shot__dark'
          : 'shot__light';
      const el = figs[i].querySelector<HTMLImageElement>(`img.${want}`)
        ?? figs[i].querySelector<HTMLImageElement>('img')!;
      return el.currentSrc || el.src;
    };

    const show = (i: number) => {
      cur = (i + figs.length) % figs.length;
      img.src = srcOf(cur);
      img.alt = figs[cur].getAttribute('aria-label') ?? '';
      count.textContent = `${cur + 1} / ${figs.length}`;
    };
    const open = (i: number, from: HTMLElement) => {
      opener = from;
      show(i);
      lb.hidden = false;
      animate(lb, { opacity: [0, 1] }, { duration: RM.matches ? 0 : 0.4, ease: [0.05, 0.7, 0.1, 1] });
      (lb.querySelector('[data-lb-close]') as HTMLElement).focus();
      document.addEventListener('keydown', onKey);
    };
    const close = () => {
      const done = () => {
        lb.hidden = true;
        opener?.focus();
      };
      animate(lb, { opacity: 0 }, { duration: RM.matches ? 0 : 0.2, ease: [0.3, 0, 0.8, 0.15] }).finished.then(done);
      document.removeEventListener('keydown', onKey);
    };
    function onKey(e: KeyboardEvent) {
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') show(cur - 1);
      else if (e.key === 'ArrowRight') show(cur + 1);
      else if (e.key === 'Tab') {
        // 焦点圈定
        const items = [...lb.querySelectorAll<HTMLElement>(FOCUSABLE)];
        const first = items[0];
        const last = items[items.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    }

    figs.forEach((b) => b.addEventListener('click', () => open(Number(b.dataset.index), b)));
    lb.querySelector('[data-lb-close]')!.addEventListener('click', close);
    lb.querySelector('[data-lb-scrim]')!.addEventListener('click', close);
    lb.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(cur - 1));
    lb.querySelector('[data-lb-next]')!.addEventListener('click', () => show(cur + 1));

    new MutationObserver(() => {
      if (!lb.hidden) show(cur);
    }).observe(root, { attributes: true, attributeFilter: ['data-theme'] });
  }
</script>
