---
// 提醒介绍与组件墙共用完整内容宽度。介绍只展示一次完整截图。
// 五类组件的 DOM 顺序固定为周网格、今日、两天、周视图、周列表。
// 手机纵排，中屏两列，桌面周网格跨两行，右侧四件排成两行两列。
// 所有截图保留自然比例，只有周网格卡使用站点的 elevated 样式。
import Shot from '../Shot.astro';
import reminderL from '../../assets/screenshots/22-reminder-light.png';
import reminderD from '../../assets/screenshots/22-reminder-dark.png';
import wGridL from '../../assets/screenshots/widget-weekgrid-light.png';
import wGridD from '../../assets/screenshots/widget-weekgrid-dark.png';
import wTodayL from '../../assets/screenshots/widget-today-light.png';
import wTodayD from '../../assets/screenshots/widget-today-dark.png';
import wTwoL from '../../assets/screenshots/widget-twodays-light.png';
import wTwoD from '../../assets/screenshots/widget-twodays-dark.png';
import wListL from '../../assets/screenshots/widget-weeklist-light.png';
import wListD from '../../assets/screenshots/widget-weeklist-dark.png';
import wViewL from '../../assets/screenshots/widget-weekview-light.png';
import wViewD from '../../assets/screenshots/widget-weekview-dark.png';
import { zh } from '../../i18n/zh';
import type { SiteCopy } from '../../i18n/zh';

interface Props {
  copy?: SiteCopy;
}
const c = Astro.props.copy ?? zh;
const t = c.reminders;
const widgets = [
  { key: 'weekgrid', label: t.widgets.gridLabel, light: wGridL, dark: wGridD },
  { key: 'today', label: t.widgets.todayLabel, light: wTodayL, dark: wTodayD },
  { key: 'twodays', label: t.widgets.twodaysLabel, light: wTwoL, dark: wTwoD },
  { key: 'weekview', label: t.widgets.weekviewLabel, light: wViewL, dark: wViewD },
  { key: 'weeklist', label: t.widgets.listLabel, light: wListL, dark: wListD },
] as const;
---

<section class="site-section" id="reminders" data-prototype="pinned" aria-labelledby="reminders-title">
  <div class="site-col reminders__content">
    <div class="reminders__overview" data-reveal-group="m5-flow">
      <h2 class="t-headline-large reminders__heading reveal" id="reminders-title" style="--reveal-i: 0;">{t.heading}</h2>
      <div class="reminders__intro">
        <figure class="reminders__figure reveal" data-beat-head style="--reveal-i: 1;">
          <span class="reminders__figure-frame">
            <Shot
              light={reminderL}
              dark={reminderD}
              widths={[300, 600]}
              sizes="(min-width: 600px) min(262px, calc((100vw - 72px) * 4 / 9 - 26px)), min(262px, calc(100vw - 58px))"
              alt={t.imageAlt}
              loading="lazy"
            />
          </span>
        </figure>
        <div class="reminders__copy">
          <p class="t-body-large reminders__lead reveal" style="--reveal-i: 2;">{t.stripLead}</p>
          <ol class="reminders__beats" data-reveal-group="m5-beats">
            {
              t.beats.map((b, i) => (
                <li class="reminders__beat reveal" data-beat style={`--reveal-i: ${i};`} data-i={i}>
                  <h3 class="t-title-medium">{b.title}</h3>
                  <p class="t-body-medium">{b.body}</p>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>

    <div class="reminders__widgets">
      <h3 class="t-headline-medium reminders__widgets-title reveal" style="--reveal-i: 0;">{t.widgets.heading}</h3>
      <div class="reminders__wall" data-reveal-group="m5-wall">
        {
          widgets.map((s, i) => (
            <figure
              class:list={[
                'reminders__card reveal',
                s.key === 'weekgrid'
                  ? 'site-card site-card--elevated reminders__card--grid'
                  : 'reminders__card--strip',
              ]}
              data-widget={s.key}
              style={`grid-area: ${s.key}; --reveal-i: ${i};`}
            >
              <span class="reminders__card-frame">
                <Shot
                  light={s.light}
                  dark={s.dark}
                  widths={s.key === 'weekgrid' ? [280, 560] : [420, 840]}
                  sizes={s.key === 'weekgrid'
                    ? '(min-width: 960px) 248px, (min-width: 600px) min(248px, calc((100vw - 120px) / 2)), min(248px, calc(100vw - 64px))'
                    : '(min-width: 1040px) 303px, (min-width: 960px) calc((100vw - 80px) / 2.85 - 34px), (min-width: 600px) min(406px, calc((100vw - 56px) / 2 - 34px)), min(406px, calc(100vw - 66px))'}
                  alt={s.label}
                  loading="lazy"
                />
              </span>
              <figcaption class="t-body-small reminders__card-cap">{s.label}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .reminders__content {
    display: grid;
    gap: calc(var(--site-unit) * 12);
  }
  .reminders__overview,
  .reminders__widgets {
    display: grid;
    gap: calc(var(--site-unit) * 8);
    min-inline-size: 0;
  }
  .reminders__heading {
    max-inline-size: 24ch;
  }
  .reminders__intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: calc(var(--site-unit) * 8);
    align-items: center;
  }
  .reminders__lead {
    color: var(--md-sys-color-on-surface-variant);
  }
  .reminders__copy {
    display: grid;
    gap: calc(var(--site-unit) * 6);
    min-inline-size: 0;
    max-inline-size: 46ch;
    justify-self: center;
  }
  .reminders__figure {
    margin: 0;
    inline-size: 100%;
    max-inline-size: 288px;
    justify-self: center;
  }
  .reminders__figure-frame {
    display: block;
    border-radius: var(--md-sys-shape-corner-xl);
    background: var(--md-sys-color-surface-container-low);
    border: 1px solid var(--md-sys-color-outline-variant);
    padding: calc(var(--site-unit) * 3);
  }
  :global(#reminders .reminders__figure-frame img) {
    block-size: auto;
    inline-size: 100%;
    max-inline-size: 100%;
    object-fit: contain;
    border-radius: calc(var(--site-unit) * 3);
  }
  .reminders__beats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: calc(var(--site-unit) * 6);
  }
  .reminders__beat h3 {
    color: var(--md-sys-color-on-surface);
    margin-block-end: calc(var(--site-unit) * 1);
  }
  .reminders__beat p {
    color: var(--md-sys-color-on-surface-variant);
  }
  /* 五件是网格中的同级项目，断点只改变排布，不改变阅读顺序。 */
  .reminders__wall {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'weekgrid'
      'today'
      'twodays'
      'weekview'
      'weeklist';
    gap: calc(var(--site-unit) * 6);
    align-items: stretch;
  }
  .reminders__card {
    margin: 0;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: calc(var(--site-unit) * 2);
    inline-size: 100%;
    min-inline-size: 0;
    max-inline-size: 440px;
    justify-self: center;
    padding: calc(var(--site-unit) * 4);
    border-radius: var(--md-sys-shape-corner-large);
  }
  .reminders__card--grid {
    max-inline-size: 280px;
    align-self: center;
  }
  .reminders__card--strip {
    background: var(--md-sys-color-surface-container-low);
    border: 1px solid var(--md-sys-color-outline-variant);
  }
  .reminders__card-frame {
    display: flex;
    align-items: center;
    justify-content: center;
    min-inline-size: 0;
  }
  :global(#reminders .reminders__card-frame img) {
    inline-size: 100%;
    block-size: auto;
    object-fit: contain;
    max-inline-size: 100%;
    border-radius: var(--md-sys-shape-corner-medium);
  }
  .reminders__card-cap {
    color: var(--md-sys-color-on-surface-variant);
    overflow-wrap: anywhere;
  }

  @media (min-width: 600px) {
    .reminders__content {
      gap: calc(var(--site-unit) * 16);
    }
    .reminders__intro {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
      gap: calc(var(--site-unit) * 10);
    }
    .reminders__wall {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-areas:
        'weekgrid today'
        'weekgrid twodays'
        'weekview weeklist';
    }
  }

  @media (min-width: 960px) {
    .reminders__wall {
      grid-template-columns: minmax(0, 0.85fr) repeat(2, minmax(0, 1fr));
      grid-template-areas:
        'weekgrid today twodays'
        'weekgrid weekview weeklist';
    }
  }
</style>
