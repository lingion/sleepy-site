---
// Layout invariant: copy comes first; the live timetable occupies the original main visual.
// Mobile stacks the same order without changing the existing page sections.
import Blob from '../Blob.astro';
import { onlineTrialUrl, fullWebAppUrl, repoUrl } from '../../i18n/ui';
import { zh } from '../../i18n/zh';
import type { SiteCopy } from '../../i18n/zh';
import { rowCount } from '../../lib/schools-view';

interface Props {
  /** 文案注入(T7 双语镜像):缺省 = zh */
  copy?: SiteCopy;
}
const c = Astro.props.copy ?? zh;
const t = c.hero;
---

<section class="hero site-section" id="hero" data-prototype="split" aria-labelledby="hero-title">
  <Blob variant={0} />
  <div class="site-col hero__grid">
    <div class="hero__copy">
      <h1 class="hero__slogan" id="hero-title">{t.slogan}</h1>
      <p class="t-body-large hero__sub">{t.sub}</p>
      <div class="hero__ctas">
        <a class="site-button site-button--filled hero__cta-xl" href={`${repoUrl}/releases/latest`}>{t.ctaDownload}</a>
        <a class="site-button site-button--text" href={onlineTrialUrl}>{t.ctaTrial}</a>
      </div>
      <p class="hero__ribbon tnum">
        <span class="hero__ribbon-num t-display-small">{rowCount}</span>
        <span class="hero__ribbon-unit">{t.ribbon.schools}<span class="hero__ribbon-sep" aria-hidden="true">·</span></span>
        <span class="hero__ribbon-fact">{t.ribbon.license}<span class="hero__ribbon-sep" aria-hidden="true">·</span></span>
        <span class="hero__ribbon-fact">{t.ribbon.privacy}</span>
      </p>
    </div>
    <div class="hero__device">
      <iframe
        src={fullWebAppUrl}
        title={t.demoTitle}
        loading="eager"
        referrerpolicy="strict-origin-when-cross-origin"
        data-timetable-demo
      ></iframe>
      <div class="hero__demo-caption">
        <span>{t.demoHint}</span>
        <a href={fullWebAppUrl} target="_blank" rel="noopener noreferrer">{t.demoOpen}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block-start: 120px; /* §5.2:hero 首段上 120 下 96 */
    padding-block-end: 96px;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 1fr);
    align-items: center;
    gap: calc(var(--site-unit) * 10);
  }
  /* §5.1 display-large:57/64 字重 400,clamp 36→57,tracking -0.25px;
     高级感靠尺寸差与留白,禁 600+(§5.1) */
  .hero__slogan {
    font-family: var(--site-font-stack);
    font-weight: 400;
    font-size: clamp(36px, 5vw, 57px);
    line-height: 64px;
    letter-spacing: -0.25px;
    color: var(--md-sys-color-on-surface);
    margin-block-end: calc(var(--site-unit) * 4);
    animation: rise var(--md-sys-motion-duration-long2) var(--md-sys-motion-easing-emphasize-decelerate) both;
  }
  .hero__sub {
    max-width: 46ch;
    color: var(--md-sys-color-on-surface-variant);
    margin-block-end: calc(var(--site-unit) * 8);
    animation: rise var(--md-sys-motion-duration-long2) var(--md-sys-motion-easing-emphasize-decelerate) 100ms both;
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--site-unit) * 3);
    margin-block-end: calc(var(--site-unit) * 8);
    animation: rise var(--md-sys-motion-duration-long2) var(--md-sys-motion-easing-emphasize-decelerate) 200ms both;
  }
  /* Filled XL(全页唯一实心之一):加大字号与内距 */
  .hero__cta-xl {
    font-size: 16px;
    padding: 14px 32px;
  }
  /* ribbon 不对称佐证条:大数字领头(tabular 不跳)+ 单位 + 两事实(§4 M1) */
  .hero__ribbon {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: calc(var(--site-unit) * 2);
    color: var(--md-sys-color-on-surface-variant);
    animation: rise var(--md-sys-motion-duration-long2) var(--md-sys-motion-easing-emphasize-decelerate) 200ms both;
  }
  .hero__ribbon-num {
    color: var(--md-sys-color-on-surface);
    font-variant-numeric: lining-nums tabular-nums;
    letter-spacing: -0.25px;
  }
  .hero__ribbon-unit {
    font: var(--md-sys-typescale-title-medium);
    margin-inline-end: calc(var(--site-unit) * 3);
  }
  /* 分隔点随行首禁则(巡检批 2026-10-25):「·」= U+00B7,UAX#14 类 BA,禁 break-before
     → 必须附着于前一分句尾。此前它是独立 flex item,窄屏换行点可落在它之前 → 点顶行首。
     现并入前一 span 尾部;左侧 margin 复原原 flex gap 间距节奏,右侧间距由 item 间 gap 承担 */
  .hero__ribbon-sep {
    color: var(--md-sys-color-outline);
    margin-inline-start: calc(var(--site-unit) * 2);
  }
  .hero__ribbon-fact {
    font: var(--md-sys-typescale-body-medium);
  }
  .hero__device {
    border-radius: var(--md-sys-shape-corner-xl);
    padding: calc(var(--site-unit) * 3);
    background: var(--md-sys-color-surface-container-low);
    border: 1px solid var(--md-sys-color-outline-variant);
    /* 比例钉死移入 img 本体(下条规则):双处钉 = padding 差一步的错位高度 */
  }
  .hero__device { min-inline-size: 0; }
  .hero__device iframe {
    display: block;
    inline-size: 100%;
    block-size: clamp(580px, 72vh, 760px);
    border: 0;
    border-radius: calc(var(--site-unit) * 3);
    background: var(--md-sys-color-surface);
  }
  .hero__demo-caption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 8px 16px;
    padding: 12px 4px 0;
    font: var(--md-sys-typescale-body-small);
    color: var(--md-sys-color-on-surface-variant);
  }
  .hero__demo-caption a { color: var(--md-sys-color-primary); padding-block: 8px; }
  /* §6-1~2:hero 一次性入场编排(全站唯二 @keyframes = rise/fade,零循环);图列直绘零动效 */
  @keyframes rise {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: none; }
  }
  /* 纯 opacity 档:blob 入场(§6-11 裁决 fea-major#6,循环删除并入编排)+ reduce 文字层
     (to 隐式 = Blob.astro 静态 opacity 0.65);reduce 档 [data-blob] 被 global.css animation:none 闸死 */
  @keyframes fade {
    from { opacity: 0; }
  }
  :global(#hero [data-blob]) {
    animation: fade var(--md-sys-motion-duration-long2) var(--md-sys-motion-easing-emphasize-decelerate) 200ms both;
  }
  /* reduce 文字层:位移编排降纯 opacity 200ms 直现(200ms 写死——reduce 档 duration token 归零
     不可引,同 global.css reveal 先例);delay 清零防拖尾超 §6-2 预算 */
  @media (prefers-reduced-motion: reduce) {
    .hero__slogan,
    .hero__sub,
    .hero__ctas,
    .hero__ribbon {
      animation-name: fade;
      animation-duration: 200ms;
      animation-timing-function: ease;
      animation-delay: 0ms;
    }
  }
  @media (max-width: 840px) {
    .hero {
      padding-block-start: calc(var(--site-unit) * 10);
      padding-block-end: calc(var(--site-unit) * 10);
    }
    /* R2 批准:整图下置首屏外 —— DOM 末位 = ≤840px 自然落文字/CTA/ribbon 之下 */
    .hero__grid {
      grid-template-columns: 1fr;
    }
    /* 显式定宽(CLS 0.4737 根因闸,2026-10-25 节流取证):margin-inline:auto 使
       grid item 的 stretch 失效退 fit-content,宽度转由内容决定;img{inline-size:100%}
       又依赖容器宽(循环)→ 图字节未达时内容=0 → 盒塌 padding+border 26px,图加载
       完成撑回 380 = 位移本体(rules=269 全落地仍塌实证:与 CSS 到达时机无关,
       内联样式实验同分 0.4711 反证)。min(100%,420) 使宽度恒确定(=轨道宽),
       img 比例钉形随盒宽自适应,base 规则已够 —— 无需再覆盖 */
    .hero__device {
      inline-size: min(100%, 420px);
      margin-inline: auto;
    }
  }
</style>
