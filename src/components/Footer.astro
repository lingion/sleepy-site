---
// footer — v4 spec §4:保留结构;blob#3 删(§13 R1 3→1);surface-container 深档底 + 发丝 outline-variant 顶边;
// 文案走 copy.footer(zh/en 同形键树,禁内联 ternary 硬编码——泄漏闸只 walk zh.ts)。
// 明暗两主题一律走 surface-container token 档(不锁 inverse-surface:dark 下 inverse 是浅灰,
// 与「深档底」语义相反;§17.1 dark 节奏)。
import { qqGroup, sponsorUrl, repoUrl, faqUrl, onlineTrialUrl } from '../i18n/ui';
import { zh } from '../i18n/zh';
import type { SiteCopy } from '../i18n/zh';

interface Props {
  lang: 'zh' | 'en';
  build: string;
  copy?: SiteCopy;
}
const { lang, build } = Astro.props;
const t = (Astro.props.copy ?? zh).footer;
---

<footer class="footer">
  <div class="site-col footer__inner">
    <div class="footer__grid">
      <section aria-labelledby="f-app">
        <h4 class="t-title-small" id="f-app">{t.app}</h4>
        <ul>
          <li><a href="https://github.com/lingion/sleepy/releases/latest">{t.dl}</a></li>
          <li><a href={onlineTrialUrl}>{t.trial}</a></li>
          <li><a href={repoUrl}>{t.repo}</a></li>
        </ul>
      </section>
      <section aria-labelledby="f-community">
        <h4 class="t-title-small" id="f-community">{t.community}</h4>
        <ul>
          <li><a href={faqUrl}>{t.faq}</a></li>
          <li><a href={sponsorUrl}>{t.sponsor}</a></li>
          <li><a href={`${repoUrl}/issues`}>GitHub Issues</a></li>
          <li>{t.qq} {qqGroup}</li>
        </ul>
      </section>
    </div>
    <p class="t-body-small footer__meta">
      <span>Sleepy · {t.license} · lingion</span>
      <span><a href="#hero">{t.backToTop}</a> · <span data-build={build}>{t.build}: {build}</span></span>
    </p>
    <noscript><p class="t-body-small">{t.noJs}</p></noscript>
  </div>
</footer>

<style>
  .footer {
    background: var(--md-sys-color-surface-container);
    color: var(--md-sys-color-on-surface);
    border-block-start: 1px solid var(--md-sys-color-outline-variant);
  }
  .footer__inner {
    padding-block: calc(var(--site-unit) * 16) calc(var(--site-unit) * 8);
  }
  .footer__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 200px));
    gap: calc(var(--site-unit) * 8);
  }
  .footer h4 {
    color: var(--md-sys-color-on-surface);
    margin-block-end: calc(var(--site-unit) * 3);
  }
  .footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: calc(var(--site-unit) * 2);
  }
  .footer a {
    color: var(--md-sys-color-on-surface-variant);
    text-decoration: none;
  }
  .footer a:hover {
    color: var(--md-sys-color-on-surface);
    text-decoration: underline;
  }
  .footer__meta {
    margin-block-start: calc(var(--site-unit) * 10);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: calc(var(--site-unit) * 2);
    /* 次级文本 = on-surface-variant 实色档(WCAG 闸:禁 opacity 压色) */
    color: var(--md-sys-color-on-surface-variant);
    font-variant-numeric: lining-nums tabular-nums;
  }
</style>
