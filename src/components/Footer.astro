---
// footer — v5 spec §2.1 瘦身:五链 = 站内三链(/download /schools /faq)+ 开源仓库外链 + 语言 + build 行。
// 原 App/Community 双列的外溢链接(releases/latest、在线体验、赞助、Issues、QQ 群)全部归位 /download/ 页(spec §2.4);
// 站内链绝对路径形式随 lang 加前缀(多页化:任意页面点击恒指对应语言页)。
// 文案走 copy.footer 键树(zh/en 同形,禁内联 ternary 硬编码——泄漏闸只 walk zh.ts);
// t.dl/t.trial/t.qq/t.sponsor/t.faq/t.repo/t.community/t.app 八键保留不删(Homepage 文案历史,终审 F4),本组件引用已清。
// 回顶链 = 纯锚 href="#top"(HTML 规范 fragment "top" 特例:文档无同名元素时直接滚到顶部,
// 零导航零重载;平滑滚动由全局 html{scroll-behavior}承担,reduced-motion 自动降级即时)。
// 旧实现 href=本页路径 已废——点「回到顶部」变整页重载(2026-10-27 报障)。
// 明暗两主题一律走 surface-container token 档(不锁 inverse-surface:dark 下 inverse 是浅灰,
// 与「深档底」语义相反;§17.1 dark 节奏)。
import { repoUrl } from '../i18n/ui';
import { zh } from '../i18n/zh';
import type { SiteCopy } from '../i18n/zh';

interface Props {
  lang: 'zh' | 'en';
  build: string;
  copy?: SiteCopy;
  /** 语言链 = 本页双语对侧路径(Base 透传,与 AppBar 同源) */
  mirror?: string;
}
const { lang, build, mirror = lang === 'zh' ? '/en/' : '/' } = Astro.props;
const c = Astro.props.copy ?? zh;
const t = c.footer;
const home = lang === 'zh' ? '/' : '/en/';
---

<footer class="footer">
  <div class="site-col footer__inner">
    <nav class="footer__links" aria-label={lang === 'zh' ? '页脚导航' : 'Footer navigation'}>
      <a href={`${home}download/`}>{t.dl}</a>
      <a href={`${home}schools/`}>{c.appbar.anchors.schools}</a>
      <a href={`${home}faq/`}>{t.faq}</a>
      <a href={repoUrl}>{t.repo}</a>
      <a class="footer__lang" href={mirror}>{lang === 'zh' ? 'EN' : '中文'}</a>
    </nav>
    <p class="t-body-small footer__meta">
      <span>Sleepy · {t.license} · lingion</span>
      <span><a href="#top">{t.backToTop}</a> · <span data-build={build}>{t.build}: {build}</span></span>
    </p>
    <noscript><p class="t-body-small">{t.noJs}</p></noscript>
  </div>
</footer>

<style>
  .footer {
    background: var(--md-sys-color-surface-container);
    color: var(--md-sys-color-on-surface);
    border-block-start: 1px solid var(--md-sys-color-outline-variant);
  }
  .footer__inner {
    padding-block: calc(var(--site-unit) * 16) calc(var(--site-unit) * 8);
  }
  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--site-unit) * 6);
  }
  .footer a {
    color: var(--md-sys-color-on-surface-variant);
    text-decoration: none;
  }
  .footer a:hover {
    color: var(--md-sys-color-on-surface);
    text-decoration: underline;
  }
  .footer__meta {
    margin-block-start: calc(var(--site-unit) * 10);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: calc(var(--site-unit) * 2);
    /* 次级文本 = on-surface-variant 实色档(WCAG 闸:禁 opacity 压色) */
    color: var(--md-sys-color-on-surface-variant);
    font-variant-numeric: lining-nums tabular-nums;
  }
</style>
